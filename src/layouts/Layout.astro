---
import '../styles/global.css';
import FixedHeader from '../components/FixedHeader3.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import {
	napInfo,
	buildLocalBusinessSchema,
	buildWebSiteSchema,
	buildBreadcrumbSchema,
	type BreadcrumbEntry
} from '../data/business';

export interface Props {
	title: string;
	description: string;
	canonical?: string;
	noindex?: boolean;
	nofollow?: boolean;
	/**
	 * Fil d'Ariane émis en JSON-LD (M-13 de l'audit GEO). L'accueil est ajouté
	 * automatiquement : ne passer que les niveaux suivants.
	 */
	breadcrumbs?: BreadcrumbEntry[];
}

const {
	title,
	description,
	canonical,
	noindex = false,
	nofollow = false,
	breadcrumbs = []
} = Astro.props;
// Pas de suffix global — chaque page contrôle son propre titre (max 60 chars)
const fullTitle = title;
const siteUrl = 'https://www.creationsitewebpro.com';
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteUrl).toString();
const socialImage = `${siteUrl}/images/og-image.jpg`;
const robotsContent = [
	noindex ? 'noindex' : 'index',
	nofollow ? 'nofollow' : 'follow',
	...(!noindex ? ['max-snippet:-1', 'max-image-preview:large', 'max-video-preview:-1'] : [])
].join(', ');
const phoneHref = `tel:${napInfo.phone.replace(/\s+/g, '')}`;
const whatsappNumber = napInfo.phone.replace(/\D/g, '');
const whatsappHref = `https://wa.me/${whatsappNumber}?text=Bonjour%2C%20je%20souhaite%20vous%20parler%20de%20mon%20projet%20web.`;

// L'entité est inlinée sur chaque page : les crawlers IA ne résolvent pas
// les références `@id` d'une page à l'autre (H-5 de l'audit GEO).
const localBusinessSchema = buildLocalBusinessSchema();
const websiteSchema = buildWebSiteSchema();
const breadcrumbSchema =
	breadcrumbs.length > 0
		? buildBreadcrumbSchema([{ name: 'Accueil', item: '/' }, ...breadcrumbs], canonicalUrl)
		: null;
---

<!DOCTYPE html>
<html lang="fr-MA">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={robotsContent} />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:alt" content="CreationSiteWebPro, agence web à Casablanca" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="fr_MA" />
		<meta property="og:site_name" content="CreationSiteWebPro" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImage} />
		<meta name="twitter:image:alt" content="CreationSiteWebPro, agence web à Casablanca" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate" type="application/rss+xml" title="Blog CreationSiteWebPro" href="/rss.xml" />

		<!--
			Polices chargées ici et non par un `@import` dans global.css : l'`@import`
			ajoutait un aller-retour réseau (CSS → CSS Google → woff2) avant le rendu
			du texte, au détriment du LCP (M-10 de l'audit GEO).
		-->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap"
		>
		
		<meta name="google-adsense-account" content="ca-pub-9201463900934910">
		  <!-- Consentement refusé par défaut avant toute commande de mesure -->
		  <script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('consent', 'default', {
			  analytics_storage: 'denied',
			  ad_storage: 'denied',
			  ad_user_data: 'denied',
			  ad_personalization: 'denied',
			  wait_for_update: 500
			});
			gtag('set', 'ads_data_redaction', true);
		  </script>
		  <!-- Axeptio script -->
		  <script is:inline>
			window.axeptioSettings = {
			  clientId: "670b2e5faa752cff8b2798a7",
			  cookiesVersion: "creationsitewebpro-fr-EU",
			  googleConsentMode: {
				default: {
				  analytics_storage: "denied",
				  ad_storage: "denied",
				  ad_user_data: "denied",
				  ad_personalization: "denied",
				  wait_for_update: 500
				}
			  }
			};
			(function(d, s) {
			  var t = d.getElementsByTagName(s)[0], e = d.createElement(s);
			  e.async = true; e.src = "https://static.axept.io/sdk.js";
			  t.parentNode.insertBefore(e, t);
			})(document, "script");
		  </script>
	<!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-NXNXH1YHKH"></script>
    <script is:inline>
      gtag('js', new Date());
      gtag('config', 'G-NXNXH1YHKH');
    </script>

		<meta name="google-site-verification" content="fnVkDYa43l9HV440UQFMYxR143Nlqkw95E5ZEg_2cJg" />
		<!-- Bing Webmaster Tools : son index alimente ChatGPT Search (M-2 de l'audit GEO). -->
		<meta name="msvalidate.01" content="7691B0A80104B50113138BCEA78F4D42" />
		<JsonLd data={localBusinessSchema} />
		<JsonLd data={websiteSchema} />
		{breadcrumbSchema && <JsonLd data={breadcrumbSchema} />}
	</head>	<body>
		<FixedHeader />
		<main class="site-content">
			<slot />
		</main>
		<Footer />		<!-- Floating action buttons -->
		<a href={whatsappHref} class="floating-whatsapp-btn" aria-label="Nous contacter sur WhatsApp">
			<img src="/icons/WhatsApp.svg" alt="Contacter par WhatsApp" class="floating-whatsapp-icon" width="30" height="30" />
		</a>
		<a href={phoneHref} class="floating-call-btn" aria-label="Nous appeler directement">
			<img src="/icons/phone-simple.svg" alt="Appeler l'agence" class="floating-call-icon" width="30" height="30" />
		</a>
	</body>
</html>

<style>
	.site-content {
		padding-top: 80px;
	}

	@media screen and (max-width: 1399px) {
		.site-content {
			padding-top: 70px;
		}
	}
</style>
