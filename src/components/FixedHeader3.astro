---
import Icon from "./Icon.astro";
import { napInfo } from "../data/business";

const phoneHref = napInfo.phone.replace(/\s+/g, "");
---

<header class="header">
  <div class="container header__container">
    <a class="header__logo" href="/" aria-label="CreationSiteWebPro — Accueil">
      <img
        src="/icons/modern-logo.svg"
        alt="CreationSiteWebPro"
        width="180"
        height="50"
      />
    </a>

    <button
      class="header__menu-toggle"
      type="button"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="main-navigation"
    >
      <span class="header__menu-icon" aria-hidden="true"></span>
    </button>

    <div class="header__nav-container" id="main-navigation">
      <nav class="header__nav" aria-label="Navigation principale">
        <ul class="header__nav-list">
          <li class="header__nav-item">
            <a href="/" class="header__nav-link">Accueil</a>
          </li>

          <li class="header__nav-item header__has-dropdown" id="services-menu">
            <div class="header__service-control">
              <a href="/services" class="header__nav-link services-link">Services</a>
              <button
                class="header__dropdown-toggle"
                type="button"
                aria-label="Afficher les services"
                aria-expanded="false"
                aria-controls="services-dropdown"
                aria-haspopup="true"
              >
                <span class="header__dropdown-icon" aria-hidden="true">▾</span>
              </button>
            </div>

            <ul class="header__dropdown" id="services-dropdown">
              <li><a href="/creation-site-web-casablanca">Création Site Web Casablanca</a></li>
              <li><a href="/creation-site-web-maroc">Création Site Web Maroc</a></li>
              <li><a href="/services/e-commerce-casablanca">E-commerce</a></li>
              <li><a href="/services/referencement-seo-casablanca">Référencement SEO</a></li>
              <li><a href="/services/creation-application-web">Applications web</a></li>
            </ul>
          </li>

          <li class="header__nav-item">
            <a href="/portfolio-realisations-web-casablanca-maroc" class="header__nav-link">
              Portfolio
            </a>
          </li>
          <li class="header__nav-item">
            <a href="/blog" class="header__nav-link">Blog</a>
          </li>
          <li class="header__nav-item">
            <a href="/a-propos-agence-web-casablanca" class="header__nav-link">À propos</a>
          </li>
        </ul>
      </nav>

      <div class="header__actions">
        <div class="header__contact-info">
          <a href={`tel:${phoneHref}`} class="header__contact-link">
            <Icon name="phone" className="header__contact-icon" />
            <span>{napInfo.phone}</span>
          </a>
          <a href={`mailto:${napInfo.email}`} class="header__contact-link">
            <Icon name="email" className="header__contact-icon" />
            <span>{napInfo.email}</span>
          </a>
        </div>

        <a href="/contact" class="btn btn-primary header__cta btn-icon">
          <span>Demandez un devis</span>
          <Icon name="arrow-right" className="header__cta-icon" />
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const MOBILE_BREAKPOINT = 1399;
  let cleanupHeader: (() => void) | undefined;

  function setupHeader() {
    cleanupHeader?.();
    cleanupHeader = undefined;

    const header = document.querySelector<HTMLElement>(".header");
    const menuToggle = header?.querySelector<HTMLButtonElement>(".header__menu-toggle");
    const navContainer = header?.querySelector<HTMLElement>(".header__nav-container");
    const servicesItem = header?.querySelector<HTMLElement>(".header__has-dropdown");
    const dropdownToggle = header?.querySelector<HTMLButtonElement>(".header__dropdown-toggle");
    const dropdown = header?.querySelector<HTMLElement>(".header__dropdown");

    if (!header || !menuToggle || !navContainer || !servicesItem || !dropdownToggle || !dropdown) {
      return;
    }

    const controller = new AbortController();
    const { signal } = controller;
    const isMobile = () => window.innerWidth <= MOBILE_BREAKPOINT;

    const setDropdown = (open: boolean) => {
      servicesItem.classList.toggle("header__has-dropdown--active", open);
      dropdown.classList.toggle("header__dropdown--active", open);
      dropdownToggle.setAttribute("aria-expanded", String(open));
      dropdownToggle.setAttribute(
        "aria-label",
        open ? "Masquer les services" : "Afficher les services"
      );
    };

    const setMobileMenu = (open: boolean) => {
      menuToggle.classList.toggle("header__menu-toggle--active", open);
      navContainer.classList.toggle("header__nav-container--active", open);
      menuToggle.setAttribute("aria-expanded", String(open));
      menuToggle.setAttribute("aria-label", open ? "Fermer le menu" : "Ouvrir le menu");
      document.body.classList.toggle("no-scroll", open);

      if (!open) {
        setDropdown(false);
      }
    };

    const updateScrolledState = () => {
      header.classList.toggle("header--scrolled", window.scrollY > 20);
    };

    const markCurrentPage = () => {
      const currentPath = window.location.pathname.replace(/\/+$/, "") || "/";
      const links = header.querySelectorAll<HTMLAnchorElement>(".header__nav-link");

      links.forEach((link) => {
        const href = link.getAttribute("href");
        if (!href) return;

        const normalizedHref = href.replace(/\/+$/, "") || "/";
        const isExactPage = currentPath === normalizedHref;
        const isServicesSection =
          normalizedHref === "/services" &&
          (currentPath.startsWith("/services/") ||
            currentPath.startsWith("/creation-site-web-"));
        const isSection =
          normalizedHref !== "/" &&
          normalizedHref !== "/services" &&
          currentPath.startsWith(`${normalizedHref}/`);
        const isActive = isExactPage || isServicesSection || isSection;

        link.classList.toggle("header__nav-link--active", isActive);
        if (isExactPage) {
          link.setAttribute("aria-current", "page");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    };

    menuToggle.addEventListener(
      "click",
      () => setMobileMenu(menuToggle.getAttribute("aria-expanded") !== "true"),
      { signal }
    );

    dropdownToggle.addEventListener(
      "click",
      () => setDropdown(dropdownToggle.getAttribute("aria-expanded") !== "true"),
      { signal }
    );

    servicesItem.addEventListener(
      "focusout",
      () => {
        requestAnimationFrame(() => {
          if (!servicesItem.contains(document.activeElement)) {
            setDropdown(false);
          }
        });
      },
      { signal }
    );

    navContainer.querySelectorAll<HTMLAnchorElement>("a[href]").forEach((link) => {
      link.addEventListener(
        "click",
        () => {
          if (isMobile()) setMobileMenu(false);
        },
        { signal }
      );
    });

    document.addEventListener(
      "click",
      (event) => {
        if (!(event.target instanceof Node) || header.contains(event.target)) return;
        setDropdown(false);
        if (isMobile()) setMobileMenu(false);
      },
      { signal }
    );

    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key !== "Escape") return;

        if (dropdownToggle.getAttribute("aria-expanded") === "true") {
          setDropdown(false);
          dropdownToggle.focus();
          return;
        }

        if (menuToggle.getAttribute("aria-expanded") === "true") {
          setMobileMenu(false);
          menuToggle.focus();
        }
      },
      { signal }
    );

    window.addEventListener(
      "resize",
      () => {
        if (!isMobile()) {
          setMobileMenu(false);
        }
      },
      { signal, passive: true }
    );

    window.addEventListener("scroll", updateScrolledState, { signal, passive: true });

    cleanupHeader = () => {
      controller.abort();
      document.body.classList.remove("no-scroll");
    };

    setMobileMenu(false);
    markCurrentPage();
    updateScrolledState();
  }

  document.addEventListener("astro:page-load", setupHeader);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupHeader, { once: true });
  } else {
    setupHeader();
  }
</script>

<style>
  :root {
    --header-height: 80px;
    --header-height-scrolled: 70px;
    --header-transition: 0.3s ease;
    --color-primary-rgb: 41, 98, 255;
  }

  .header {
    position: fixed;
    z-index: 1000;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--header-height);
    background-color: var(--color-background);
    box-shadow: var(--shadow-sm);
    transition:
      height var(--header-transition),
      box-shadow var(--header-transition);
  }

  .header--scrolled {
    height: var(--header-height-scrolled);
    box-shadow: var(--shadow-md);
  }

  .header__container {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .header__logo {
    position: relative;
    z-index: 1001;
    flex: 0 0 auto;
  }

  .header__logo img {
    display: block;
    width: auto;
    height: 50px;
    transition: height var(--header-transition);
  }

  .header--scrolled .header__logo img {
    height: 40px;
  }

  .header__menu-toggle {
    position: relative;
    z-index: 1001;
    display: none;
    width: 48px;
    height: 48px;
    margin: -12px;
    padding: 12px;
    border: 0;
    border-radius: 4px;
    background: transparent;
    cursor: pointer;
    touch-action: manipulation;
  }

  .header__menu-toggle:hover,
  .header__menu-toggle:focus-visible,
  .header__dropdown-toggle:hover,
  .header__dropdown-toggle:focus-visible {
    background-color: rgba(0, 0, 0, 0.06);
  }

  .header__menu-toggle:focus-visible,
  .header__dropdown-toggle:focus-visible,
  .header__nav-link:focus-visible,
  .header__dropdown a:focus-visible,
  .header__contact-link:focus-visible,
  .header__cta:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .header__menu-icon,
  .header__menu-icon::before,
  .header__menu-icon::after {
    position: absolute;
    left: 12px;
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--color-text-primary);
    transition: transform var(--header-transition);
  }

  .header__menu-icon {
    top: 23px;
  }

  .header__menu-icon::before,
  .header__menu-icon::after {
    left: 0;
    content: "";
  }

  .header__menu-icon::before {
    transform: translateY(-8px);
  }

  .header__menu-icon::after {
    transform: translateY(8px);
  }

  .header__menu-toggle--active .header__menu-icon {
    background-color: transparent;
  }

  .header__menu-toggle--active .header__menu-icon::before {
    transform: rotate(45deg);
  }

  .header__menu-toggle--active .header__menu-icon::after {
    transform: rotate(-45deg);
  }

  .header__nav-container {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: flex-end;
    height: 100%;
    gap: var(--space-lg);
  }

  .header__nav,
  .header__nav-list,
  .header__nav-item,
  .header__service-control {
    height: 100%;
  }

  .header__nav-list {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .header__nav-item {
    position: relative;
    display: flex;
    align-items: center;
  }

  .header__service-control {
    display: flex;
    align-items: center;
  }

  .header__nav-link {
    position: relative;
    display: flex;
    align-items: center;
    height: 100%;
    padding: 0 var(--space-md);
    color: var(--color-text-primary);
    font-weight: 500;
    text-decoration: none;
    transition: color var(--header-transition);
  }

  .services-link {
    padding-right: 0.25rem;
  }

  .header__nav-link:hover,
  .header__contact-link:hover {
    color: var(--color-primary);
  }

  .header__nav-link::after {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 3px;
    background-color: var(--color-primary);
    content: "";
    transform: translateX(-50%);
    transition: width var(--header-transition);
  }

  .header__nav-link:hover::after,
  .header__nav-link--active::after {
    width: 60%;
  }

  .header__nav-link--active {
    color: var(--color-primary);
    font-weight: 600;
  }

  .header__dropdown-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: var(--color-text-primary);
    cursor: pointer;
  }

  .header__dropdown-icon {
    font-size: 0.75rem;
    transition: transform 0.2s ease;
  }

  .header__has-dropdown--active .header__dropdown-icon {
    color: var(--color-primary);
    transform: rotate(180deg);
  }

  .header__dropdown {
    position: absolute;
    z-index: 1000;
    top: 100%;
    left: 0;
    min-width: 250px;
    margin: 0;
    padding: var(--space-md);
    border-radius: var(--border-radius-md);
    background-color: var(--color-background);
    box-shadow: var(--shadow-md);
    list-style: none;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition:
      opacity var(--header-transition),
      visibility var(--header-transition),
      transform var(--header-transition);
  }

  .header__has-dropdown:hover .header__dropdown,
  .header__dropdown--active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .header__dropdown li:not(:last-child) {
    margin-bottom: var(--space-xs);
  }

  .header__dropdown a {
    display: block;
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--border-radius-sm);
    color: var(--color-text-primary);
    font-size: 0.95rem;
    text-decoration: none;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .header__dropdown a:hover {
    color: var(--color-primary);
    background-color: var(--color-surface);
    transform: translateX(5px);
  }

  .header__actions,
  .header__contact-info,
  .header__contact-link {
    display: flex;
    align-items: center;
  }

  .header__actions,
  .header__contact-info {
    gap: var(--space-md);
  }

  .header__contact-link {
    color: var(--color-text-primary);
    font-size: 0.95rem;
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--header-transition);
  }

  .header__contact-icon {
    width: 18px;
    height: 18px;
    margin-right: 8px;
    fill: var(--color-primary);
  }

  .header__cta {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    overflow: hidden;
    border: 0;
    border-radius: var(--border-radius-md);
    box-shadow: var(--shadow-sm);
    font-weight: 600;
    white-space: nowrap;
    transition:
      box-shadow var(--header-transition),
      transform var(--header-transition);
  }

  .header__cta::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(
      120deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.2) 50%,
      rgba(255, 255, 255, 0) 100%
    );
    content: "";
    transform: translateX(-100%);
    transition: transform 0.6s ease;
  }

  .header__cta:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .header__cta:hover::before {
    transform: translateX(100%);
  }

  .header__cta-icon {
    width: 16px;
    height: 16px;
    margin-left: 6px;
    transition: transform var(--header-transition);
  }

  .header__cta:hover .header__cta-icon {
    transform: translateX(3px);
  }

  @media screen and (max-width: 1399px) {
    :root {
      --header-height: 70px;
      --header-height-scrolled: 60px;
    }

    .header__menu-toggle {
      display: block;
    }

    .header__nav-container {
      position: fixed;
      top: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      width: min(320px, 88vw);
      height: 100vh;
      height: 100dvh;
      padding: 100px var(--space-lg) var(--space-lg);
      overflow-x: hidden;
      overflow-y: auto;
      overscroll-behavior: contain;
      background-color: var(--color-background);
      box-shadow: var(--shadow-lg);
      opacity: 0;
      visibility: hidden;
      transform: translateX(100%);
      transition:
        opacity var(--header-transition),
        visibility var(--header-transition),
        transform var(--header-transition);
    }

    .header__nav-container--active {
      opacity: 1;
      visibility: visible;
      transform: translateX(0);
    }

    .header__nav,
    .header__nav-list,
    .header__nav-item,
    .header__service-control {
      width: 100%;
      height: auto;
    }

    .header__nav-list,
    .header__nav-item {
      flex-direction: column;
      align-items: flex-start;
    }

    .header__nav-item {
      margin-bottom: var(--space-md);
    }

    .header__service-control {
      display: flex;
      align-items: center;
    }

    .header__nav-link {
      width: 100%;
      height: auto;
      padding: var(--space-sm) 0;
    }

    .services-link {
      flex: 1;
    }

    .header__nav-link::after {
      display: none;
    }

    .header__dropdown-toggle {
      flex: 0 0 44px;
      width: 44px;
      height: 44px;
    }

    .header__dropdown-icon {
      font-size: 0.95rem;
    }

    .header__has-dropdown:hover .header__dropdown {
      opacity: 0;
      visibility: hidden;
    }

    .header__dropdown,
    .header__has-dropdown:hover .header__dropdown {
      position: static;
      display: none;
      width: 100%;
      min-width: 0;
      margin: 0;
      padding: 0;
      border-left: 3px solid transparent;
      border-radius: 0 var(--border-radius-sm) var(--border-radius-sm) 0;
      background-color: rgba(var(--color-primary-rgb), 0.05);
      box-shadow: none;
      opacity: 0;
      visibility: hidden;
      transform: none;
    }

    .header__dropdown--active,
    .header__has-dropdown:hover .header__dropdown--active {
      display: block;
      margin: var(--space-xs) 0;
      padding: var(--space-sm) 0 var(--space-sm) var(--space-md);
      border-left-color: var(--color-primary);
      opacity: 1;
      visibility: visible;
    }

    .header__dropdown a {
      margin-bottom: 4px;
      padding: var(--space-md);
      background-color: rgba(var(--color-primary-rgb), 0.03);
      font-size: 0.9rem;
      white-space: normal;
    }

    .header__actions {
      flex-direction: column;
      align-items: flex-start;
      width: 100%;
      margin-top: var(--space-xl);
    }

    .header__contact-info {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-sm);
    }

    .header__cta {
      width: 100%;
      margin-top: var(--space-md);
      text-align: center;
    }

    :global(body.no-scroll) {
      overflow: hidden;
    }
  }

  @media screen and (max-width: 767px) {
    .header__logo img {
      height: 40px;
    }

    .header--scrolled .header__logo img {
      height: 35px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header,
    .header__logo img,
    .header__menu-icon,
    .header__menu-icon::before,
    .header__menu-icon::after,
    .header__nav-container,
    .header__nav-link::after,
    .header__dropdown,
    .header__dropdown-icon,
    .header__cta,
    .header__cta::before,
    .header__cta-icon {
      transition: none;
    }
  }
</style>
