---
interface BreadcrumbItem {
  name: string;
  item: string;
}

interface Props {
  data: Record<string, unknown>;
  breadcrumbs?: BreadcrumbItem[];
}

const { data, breadcrumbs = [] } = Astro.props;
const siteUrl = Astro.site ?? new URL('https://www.creationsitewebpro.com');

// Les données métier restent sous le contrôle de la page qui les fournit.
// Un BreadcrumbList éventuel est émis comme un schéma distinct, sans modifier
// Organization, LocalBusiness ou leur zone desservie.
const schemas: Record<string, unknown>[] = [data];

if (breadcrumbs.length > 0) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.name,
      item: item.item.startsWith('http')
        ? item.item
        : new URL(item.item, siteUrl).toString(),
    })),
  });
}

const serializeSchema = (schema: Record<string, unknown>) =>
  JSON.stringify(schema).replace(/</g, '\\u003c');
---

{schemas.map((schema) => (
  <script
    type="application/ld+json"
    is:inline
    set:html={serializeSchema(schema)}
  />
))}
