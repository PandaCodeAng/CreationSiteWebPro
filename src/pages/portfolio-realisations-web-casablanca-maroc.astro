---
import Layout from '../layouts/Layout.astro';
import CTAButton from '../components/CTAButton.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import JsonLd from '../components/JsonLd.astro';
import { LOCAL_BUSINESS_ID, WEBSITE_ID } from '../data/business';

const canonical = 'https://www.creationsitewebpro.com/portfolio-realisations-web-casablanca-maroc';
const schemaBreadcrumbs = [{ name: 'Portfolio et réalisations' }];

const pageTitle = "Portfolio | Réalisations au Maroc";
const pageDescription = "Découvrez une sélection de sites web réalisés pour des activités de tourisme et de restauration, avec les livrables présentés pour chaque projet.";

const projects = [
  {
    title: "Executive Travel - Agence de Voyage",
    description: "Création d'un site premium pour une agence de voyage de luxe, offrant une expérience utilisateur fluide et élégante.",
    image: "/images/executive-travel.webp",
    tags: ["Site Vitrine", "Tourisme", "Premium"],
    results: ["Présentation claire des offres", "Parcours responsive", "Accès direct aux demandes de réservation"],
    url: "https://executivetravel.fr/"
  },
  {
    title: "Essaouira Spirit - Tourisme Marocain",
    description: "Développement d'une plateforme mettant en valeur les attractions touristiques d'Essaouira avec une interface immersive.",
    image: "/images/essaouira-spirit.jpg",
    tags: ["Tourisme", "Culture", "Design Immersif"],
    results: ["Valorisation des expériences locales", "Navigation visuelle", "Contenus adaptés à plusieurs audiences"],
    // H-4 de l'audit GEO : https://www.essaouiraspirit.ma/ échoue en TLS
    // (SEC_E_WRONG_PRINCIPAL) puis renvoie 404. Le lien est retiré tant que le
    // site n'est pas rétabli — un lien mort dans un portfolio d'agence web est
    // la pire preuve possible. Remettre l'URL ici une fois le site réparé.
    url: null,
    unavailableNote: "Site en cours de refonte : lien temporairement indisponible."
  },
  {
    title: "Restaurant Le Cely - Gastronomie",
    description: "Conception d'un site moderne pour un restaurant gastronomique, facilitant les réservations en ligne et la présentation des menus.",
    image: "/images/le-cely.webp",
    tags: ["Restauration", "E-réservation", "Gastronomie"],
    results: ["Présentation du restaurant et de sa carte", "Parcours mobile", "Accès simplifié aux informations pratiques"],
    url: "https://restaurantlecely.fr/"
  }
];


// Le portfolio est le seul endroit du site avec des preuves vérifiables : il doit
// être balisé. Une réalisation dont le lien est cassé est listée sans 'url'
// plutôt qu’avec une URL morte (H-4 de l’audit GEO).
const portfolioSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonical}#portfolio`,
  name: 'Réalisations web à Casablanca et au Maroc',
  description: pageDescription,
  url: canonical,
  isPartOf: { '@id': WEBSITE_ID },
  about: { '@id': LOCAL_BUSINESS_ID },
  inLanguage: 'fr-MA',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: projects.length,
    itemListElement: projects.map((project, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'CreativeWork',
        name: project.title,
        description: project.description,
        image: `https://www.creationsitewebpro.com${project.image}`,
        creator: { '@id': LOCAL_BUSINESS_ID },
        ...(project.url ? { url: project.url } : {})
      }
    }))
  }
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  breadcrumbs={schemaBreadcrumbs}
>
  <JsonLd data={portfolioSchema} />
  <div class="portfolio-page">
    <h1>{pageTitle}</h1>
    <p class="intro">{pageDescription}</p>
    
    <div class="highlight-section">
      <h2 class="highlight-title">Découvrez nos dernières réalisations</h2>
      <p class="highlight-text">Nous sommes fiers de vous présenter nos projets les plus récents, démontrant notre expertise dans différents secteurs, du tourisme à la gastronomie.</p>
    </div><section class="projects">
      {projects.map((project) => (
        <div class="project-card">
          <OptimizedImage 
            src={project.image} 
            alt={project.title} 
            className="project-image"
            width={400} 
            height={300} 
          />      
          <div class="project-details">
            <h2>{project.title}</h2>
            <p>{project.description}</p>
            <div class="tags">
              {project.tags.map(tag => <span class="tag">{tag}</span>)}
            </div>
            <h3>Livrables clés :</h3>
            <ul class="results">
              {project.results.map(result => <li>{result}</li>)}
            </ul>
            {project.url
              ? <CTAButton text="Visiter le site" href={project.url} targetBlank={true} />
              : <p class="project-unavailable">{project.unavailableNote}</p>}
          </div>
        </div>
      ))}
    </section>
    <section class="cta-section">
      <h2>Vous avez un projet similaire&nbsp;?</h2>
      <p>Présentez-nous vos objectifs, vos contenus et les fonctionnalités attendues.</p>
      <a href="/contact" class="cta-button">Demander un devis</a>
    </section>
  </div>
</Layout>

<style>
  .cta-button {
    display: inline-block;
    background-color: var(--color-secondary);
    color: white;
    padding: 0.75rem 1.5rem;
    text-decoration: none;
    border-radius: 5px;
    transition: background-color 0.3s ease, transform 0.3s ease;
    font-size: clamp(1rem, 2vw, 1.1rem);
  }
  .social-proof2 {
    margin-top: 1rem;
    font-size: clamp(0.9rem, 2vw, 1rem);
    font-weight: bold;
  }
  .cta-button:hover {
    background-color: #ff8533;
    transform: translateY(-3px);
  }
  .urgency {
    display: inline-block;
    background-color: #ff4500;
    color: white;
    font-size: 0.8em;
    padding: 0.2em 0.5em;
    border-radius: 3px;
    margin-left: 0.5em;
  }
  .portfolio-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem;
    margin-top: 0;
  }

  h1 {
    color: var(--color-primary);
    font-size: clamp(1.5rem, 5vw, 2.5rem);
    margin-bottom: 0.5rem;
    text-align: center;
  }

  .intro {
    font-size: clamp(0.9rem, 3vw, 1.2rem);
    margin-bottom: 2rem;
    text-align: center;
  }

  .project-card {
    background-color: #f9f9f9;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    margin-bottom: 2rem;
    transition: transform 0.3s ease;
    position: relative;
  }

  /* Styles spécifiques pour les 3 premiers projets (nouveaux) */
  .project-card:nth-child(1),
  .project-card:nth-child(2),
  .project-card:nth-child(3) {
    border-top: 4px solid var(--color-primary);
    box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
    background-color: #fff;
    position: relative;
  }
  
  .project-card:nth-child(1)::before,
  .project-card:nth-child(2)::before,
  .project-card:nth-child(3)::before {
    content: "Nouveau";
    position: absolute;
    top: 10px;
    right: 10px;
    background-color: var(--color-accent, #ff6b6b);
    color: white;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: bold;
    z-index: 2;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
  }

  .project-card:hover {
    transform: translateY(-5px);
  }

  .project-image {
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .project-details {
    padding: 1rem;
  }

  .project-details h2 {
    font-size: clamp(1.2rem, 4vw, 1.8rem);
    color: var(--color-secondary);
    margin-bottom: 0.5rem;
  }

  .project-details p {
    font-size: clamp(0.8rem, 3vw, 1rem);
    margin-bottom: 1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .tag {
    background-color: var(--color-primary);
    color: white;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-size: clamp(0.7rem, 2vw, 0.9rem);
  }

  .results {
    list-style-type: none;
    padding-left: 0;
    margin-bottom: 1rem;
  }

  .results li {
    font-size: clamp(0.8rem, 2.5vw, 1rem);
    margin-bottom: 0.5rem;
    padding-left: 1.5rem;
    position: relative;
  }

  .results li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--color-secondary);
  }

  .social-proof {
    background-color: #f0f0f0;
    padding: 2rem 1rem;
    border-radius: 8px;
    margin-top: 3rem;
  }

  .social-proof h2 {
    font-size: clamp(1.2rem, 4vw, 2rem);
    text-align: center;
    margin-bottom: 1.5rem;
  }

  blockquote {
    font-style: italic;
    margin-bottom: 1.5rem;
    padding: 1rem;
    background-color: white;
    border-left: 3px solid var(--color-secondary);
    font-size: clamp(0.8rem, 2.5vw, 1rem);
  }

  .cta-section {
    background-color: var(--color-primary);
    color: white;
    text-align: center;
    padding: 2rem 1rem;
    border-radius: 8px;
    margin-top: 3rem;
  }

  .cta-section h2 {
    font-size: clamp(1.2rem, 4vw, 2rem);
    margin-bottom: 1rem;
  }

  .cta-section p {
    font-size: clamp(0.9rem, 3vw, 1.1rem);
    margin-bottom: 1.5rem;
  }
  .testimonial-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    color: white;
    font-weight: 600;
    font-size: 1rem;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
    margin-right: 1rem;
    flex-shrink: 0;
  }

  .testimonial-content {
    display: flex;
    align-items: center;
  }

  .testimonial-text {
    flex: 1;
  }

  .testimonial-text cite {
    display: block;
    margin-top: 0.5rem;
    font-weight: 600;
    font-style: normal;
  }

  @media (max-width: 640px) {
    .testimonial-content {
      flex-direction: column;
    }
    
    .testimonial-avatar {
      margin-right: 0;
      margin-bottom: 0.75rem;
    }
  }
  @media (max-width: 1067px) {
    .portfolio-page {
      padding: 0.5rem;
      margin-top: 0;
    }
    .project-card {
      display: block;
    }
  }
  @media (max-width: 768px) {
    .portfolio-page {
      padding: 0.5rem;
      margin-top: 0;
    }
    .project-card {
      display: block;
    }
  }
  @media (max-width: 459px) {
    .portfolio-page {
      padding: 0.5rem;
      margin-top: 0;
    }
  }
  @media (min-width: 769px) {
    
    .project-card {
      display: flex;
    }

    .project-image {
      width: 40%;
    }

    .project-details {
      width: 60%;
    }
  }

  @media (max-width: 320px) {
    .portfolio-page {
      padding: 0.5rem;
      margin-top: 0;
    }

    h1 {
      font-size: 1.5rem;
    }

    .intro {
      font-size: 0.8rem;
    }

    .project-details {
      padding: 0.75rem;
    }

    .project-details h2 {
      font-size: 1.2rem;
    }

    .project-details p {
      font-size: 0.8rem;
    }

    .tag {
      font-size: 0.7rem;
      padding: 0.1rem 0.3rem;
    }

    .results li {
      font-size: 0.8rem;
      padding-left: 1.2rem;
    }

    .social-proof {
      padding: 1.5rem 0.75rem;
    }

    blockquote {
      font-size: 0.8rem;
      padding: 0.75rem;
    }

    .cta-section {
      padding: 1.5rem 0.75rem;
    }

    .cta-section h2 {
      font-size: 1.2rem;
    }

    .cta-section p {
      font-size: 0.8rem;
    }
  }
  .highlight-section {
    background: linear-gradient(135deg, rgba(var(--color-primary-rgb, 0, 102, 204), 0.1), rgba(var(--color-accent-rgb, 255, 107, 107), 0.1));
    padding: 1.5rem;
    border-radius: 10px;
    margin-bottom: 2rem;
    border-left: 4px solid var(--color-primary);
  }

  .highlight-title {
    color: var(--color-primary);
    font-size: clamp(1.2rem, 3vw, 1.8rem);
    margin-bottom: 0.5rem;
  }

  .highlight-text {
    font-size: clamp(0.9rem, 2vw, 1.1rem);
    margin-bottom: 0;
    line-height: 1.6;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const projectCards = document.querySelectorAll('.project-card');
    projectCards.forEach(card => {
      card.addEventListener('click', () => {
        card.classList.toggle('expanded');
      });
    });
  });
</script>
