---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import JsonLd from '../../components/JsonLd.astro';
import OptimizedImage from '../../components/OptimizedImage.astro';
import { LOCAL_BUSINESS_ID } from '../../data/business';

const schemaBreadcrumbs = [
  { name: 'Services', item: '/services' },
  { name: 'Création d’application web' }
];

const canonical = 'https://www.creationsitewebpro.com/services/creation-application-web';
const title = 'Création d’application web sur mesure au Maroc';
const description = 'Conception d’applications web sur mesure pour digitaliser un processus, créer un portail client ou développer un outil métier au Maroc.';

const faq = [
  {
    question: 'Quel type d’application web pouvez-vous développer ?',
    answer: 'Nous étudions les portails clients, outils de gestion, espaces membres, plateformes de réservation et applications métier accessibles depuis un navigateur.'
  },
  {
    question: 'Comment est calculé le prix d’une application web ?',
    answer: 'Le budget dépend des parcours, des rôles utilisateurs, des intégrations et des exigences de sécurité. Un cadrage fonctionnel est réalisé avant le devis.'
  },
  {
    question: 'Le code et les données restent-ils accessibles au client ?',
    answer: 'Les conditions de propriété, d’hébergement, de maintenance, d’accès au code et de réversibilité sont précisées dans la proposition commerciale.'
  }
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${canonical}#service`,
  name: title,
  description,
  url: canonical,
  provider: { '@id': LOCAL_BUSINESS_ID },
  areaServed: {
    '@type': 'Country',
    name: 'Maroc'
  },
  serviceType: 'Conception et développement d’applications web',
  // Aucun prix de départ public sur ce service : il est chiffré au cadrage. On
  // déclare une offre en MAD sans montant plutôt qu'un chiffre inventé (H-3).
  offers: {
    '@type': 'Offer',
    name: 'Application web sur mesure',
    description: 'Périmètre, calendrier et budget définis au cadrage puis chiffrés au devis, en dirhams.',
    priceCurrency: 'MAD',
    availability: 'https://schema.org/InStock',
    url: 'https://www.creationsitewebpro.com/creation-site-web-casablanca-prix',
    seller: { '@id': LOCAL_BUSINESS_ID }
  }
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};
---

<Layout title={title} description={description} canonical={canonical} breadcrumbs={schemaBreadcrumbs}>
  <JsonLd data={schema} />
  <JsonLd data={faqSchema} />

  <div class="application-page">
    <Breadcrumbs items={[
      { name: 'Accueil', url: '/' },
      { name: 'Services', url: '/services' },
      { name: 'Application web' }
    ]} />

    <header class="application-page__hero">
      <div>
        <p class="eyebrow">Développement sur mesure</p>
        <h1>Une application web conçue autour de votre métier</h1>
        <p>{description}</p>
        <a class="button" href="/contact">Présenter mon projet</a>
      </div>
      <OptimizedImage
        src="/images/project-management-app.jpg"
        alt="Interface d’une application web sur mesure"
        width={600}
        height={400}
        loading="eager"
        fetchpriority="high"
        sizes="(max-width: 800px) 100vw, 50vw"
      />
    </header>

    <section aria-labelledby="use-cases">
      <h2 id="use-cases">Cas d’usage possibles</h2>
      <div class="cards">
        <article><h3>Portail client</h3><p>Documents, demandes, paiements, notifications et suivi dans un espace sécurisé.</p></article>
        <article><h3>Outil métier</h3><p>Centralisation des données et automatisation d’étapes aujourd’hui gérées manuellement.</p></article>
        <article><h3>Plateforme de services</h3><p>Comptes utilisateurs, réservation, catalogue, messagerie ou abonnements selon le besoin.</p></article>
      </div>
    </section>

    <section class="process" aria-labelledby="process-title">
      <h2 id="process-title">Du besoin à la mise en production</h2>
      <ol>
        <li><strong>Cadrage :</strong> utilisateurs, parcours, données, contraintes et critères de réussite.</li>
        <li><strong>Prototype :</strong> validation des écrans et des fonctionnalités prioritaires.</li>
        <li><strong>Développement :</strong> réalisation par étapes avec démonstrations intermédiaires.</li>
        <li><strong>Recette :</strong> tests fonctionnels, sécurité, performance et corrections.</li>
        <li><strong>Livraison :</strong> déploiement, documentation et modalités de maintenance.</li>
      </ol>
    </section>

    <section aria-labelledby="faq-title">
      <h2 id="faq-title">Questions fréquentes</h2>
      <div class="faq-list">
        {faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .application-page {
    max-width: 1120px;
    margin: 0 auto;
    padding: 2rem 1.25rem;
  }

  .application-page__hero {
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: 3rem;
    align-items: center;
    margin: 2rem 0 4rem;
  }

  .eyebrow {
    color: var(--color-secondary);
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  h1, h2, h3 {
    color: var(--color-primary);
  }

  h1 {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1.1;
  }

  h2 {
    margin-top: 3.5rem;
    font-size: clamp(1.7rem, 3vw, 2.3rem);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .cards article,
  .process,
  details {
    padding: 1.4rem;
    border: 1px solid rgba(7, 59, 76, .14);
    border-radius: .9rem;
    background: #fff;
  }

  .process {
    background: #f4f8fa;
  }

  .process li {
    margin-bottom: .75rem;
  }

  .faq-list {
    display: grid;
    gap: .8rem;
  }

  summary {
    cursor: pointer;
    color: var(--color-primary);
    font-weight: 700;
  }

  .button {
    display: inline-block;
    margin-top: 1rem;
    padding: .85rem 1.25rem;
    border-radius: .5rem;
    background: var(--color-secondary);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 800px) {
    .application-page__hero,
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
