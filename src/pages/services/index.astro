---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import JsonLd from '../../components/JsonLd.astro';

const canonical = 'https://www.creationsitewebpro.com/services';
const title = 'Services web à Casablanca et au Maroc';
const description = 'Création de sites vitrines, boutiques e-commerce, applications web et accompagnement SEO pour les entreprises de Casablanca et du Maroc.';

const services = [
  {
    title: 'Création de site web',
    description: 'Un site vitrine responsive, rapide et administrable, conçu autour de vos objectifs commerciaux.',
    href: '/creation-site-web-casablanca'
  },
  {
    title: 'Site e-commerce',
    description: 'Une boutique en ligne adaptée au marché marocain, à votre catalogue et à vos modes de livraison et de paiement.',
    href: '/services/e-commerce-casablanca'
  },
  {
    title: 'Référencement SEO',
    description: 'Audit technique, contenu utile, SEO local et suivi mesurable de votre visibilité organique.',
    href: '/services/referencement-seo-casablanca'
  },
  {
    title: 'Application web',
    description: 'Des outils métier sur mesure : espace client, portail interne, automatisation ou plateforme web.',
    href: '/services/creation-application-web'
  }
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Services web de CreationSiteWebPro',
  itemListElement: services.map((service, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: `https://www.creationsitewebpro.com${service.href}`,
    name: service.title
  }))
};
---

<Layout title={title} description={description} canonical={canonical}>
  <JsonLd data={serviceSchema} />
  <div class="services-page">
    <Breadcrumbs items={[{ name: 'Accueil', url: '/' }, { name: 'Services' }]} />

    <header class="services-page__intro">
      <p class="eyebrow">Solutions digitales</p>
      <h1>Des services web adaptés à votre entreprise</h1>
      <p>{description}</p>
    </header>

    <section aria-labelledby="services-title">
      <h2 id="services-title">Nos expertises</h2>
      <div class="services-grid">
        {services.map((service) => (
          <article class="service-card">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <a href={service.href}>Découvrir ce service <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    </section>

    <section class="services-page__method" aria-labelledby="method-title">
      <h2 id="method-title">Une méthode claire</h2>
      <ol>
        <li><strong>Cadrage :</strong> objectifs, utilisateurs, contenus et contraintes.</li>
        <li><strong>Conception :</strong> architecture, parcours et interface.</li>
        <li><strong>Production :</strong> développement, intégration et contrôles qualité.</li>
        <li><strong>Mise en ligne :</strong> formation, mesure et accompagnement.</li>
      </ol>
    </section>

    <aside class="services-page__cta">
      <h2>Parlons de votre projet</h2>
      <p>Décrivez votre besoin pour recevoir une recommandation et un devis adaptés.</p>
      <a class="button" href="/contact">Demander un devis</a>
    </aside>
  </div>
</Layout>

<style>
  .services-page {
    max-width: 1120px;
    margin: 0 auto;
    padding: 2rem 1.25rem;
  }

  .services-page__intro {
    max-width: 760px;
    margin: 2rem auto 4rem;
    text-align: center;
  }

  .eyebrow {
    color: var(--color-secondary);
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  h1, h2, h3 {
    color: var(--color-primary);
  }

  h1 {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1.1;
  }

  h2 {
    font-size: clamp(1.7rem, 3vw, 2.4rem);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1.25rem;
  }

  .service-card {
    padding: 1.5rem;
    border: 1px solid rgba(7, 59, 76, .14);
    border-radius: 1rem;
    background: #fff;
    box-shadow: 0 10px 30px rgba(7, 59, 76, .07);
  }

  .service-card a {
    color: var(--color-secondary);
    font-weight: 700;
  }

  .services-page__method,
  .services-page__cta {
    margin-top: 4rem;
    padding: 2rem;
    border-radius: 1rem;
    background: #f4f8fa;
  }

  .services-page__method li {
    margin-bottom: .8rem;
  }

  .services-page__cta {
    text-align: center;
    background: var(--color-primary);
    color: #fff;
  }

  .services-page__cta h2 {
    color: #fff;
  }

  .button {
    display: inline-block;
    margin-top: .75rem;
    padding: .85rem 1.25rem;
    border-radius: .5rem;
    background: var(--color-accent);
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: none;
  }
</style>
