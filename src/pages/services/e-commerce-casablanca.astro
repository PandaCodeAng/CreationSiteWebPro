---
import Layout from '../../layouts/Layout.astro';
import CTAButton from '../../components/CTAButton.astro';
import OptimizedImage from '../../components/OptimizedImage.astro';
import JsonLd from '../../components/JsonLd.astro';
import Icon from '../../components/Icon.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const breadcrumbItems = [
  { name: 'Accueil', url: '/' },
  { name: 'Services', url: '/services' },
  { name: 'E-commerce' }
];
const canonical = "https://www.creationsitewebpro.com/services/e-commerce-casablanca";
const pageTitle = "Création de Site E-commerce à Casablanca";
const pageDescription = "Création de boutiques en ligne à Casablanca : catalogue, commandes, paiement, livraison, administration et socle SEO adaptés au périmètre du projet.";

const features = [
  {
    title: "Design Responsive",
    description: "Parcours adaptés aux mobiles, tablettes et ordinateurs.",
    icon: "mobile"
  },
  {
    title: "Paiement Sécurisé",
    description: "Intégration des moyens de paiement validés selon le prestataire et le compte marchand.",
    icon: "lock"
  },
  {
    title: "Gestion de Stock",
    description: "Gestion du catalogue et des stocks selon les règles définies pendant le cadrage.",
    icon: "box"
  },
  {
    title: "SEO E-commerce",
    description: "Structure technique pour l'indexation des catégories et des fiches produits.",
    icon: "search"
  }
];

const faqItems = [
  {
    question: "Combien coûte la création d'un site e-commerce à Casablanca ?",
    answer: "Une boutique en ligne démarre à 15 000 MAD. Le devis final dépend du catalogue, des paiements, des livraisons, des contenus et des intégrations nécessaires."
  },
  {
    question: "Combien de temps faut-il pour créer un site e-commerce ?",
    answer: "Le calendrier dépend du volume du catalogue, des contenus, des intégrations et des validations. Les étapes et la date de livraison prévisionnelle sont précisées dans le devis."
  },
  {
    question: "Quels modes de paiement pouvez-vous intégrer au Maroc ?",
    answer: "Le choix dépend des prestataires disponibles, de votre compte marchand et de vos besoins. Les moyens de paiement retenus et leurs conditions d'intégration sont confirmés pendant le cadrage."
  }
];

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${canonical}#service`,
  "name": pageTitle,
  "description": pageDescription,
  "url": canonical,
  "provider": {
    "@id": "https://www.creationsitewebpro.com/#localbusiness"
  },
  "areaServed": {
    "@type": "City",
    "name": "Casablanca"
  },
  "serviceType": "Création de boutique e-commerce"
};
---

<Layout title={pageTitle} description={pageDescription} canonical={canonical}>
  <JsonLd data={schemaData} />
  
  <div class="e-commerce-casablanca">
    <Breadcrumbs items={breadcrumbItems} />
    <h1>{pageTitle}</h1>
    <p class="intro">{pageDescription}</p>

    <section class="hero">
      <OptimizedImage 
        src="/images/e-commerce-casablanca-hero.jpg" 
        alt="Création de site e-commerce à Casablanca" 
        width={600} 
        height={300} 
        loading="eager"
        fetchpriority="high"
        sizes="(max-width: 800px) 100vw, 600px"
      />
    </section>

    <section class="features">
      <h2>Fonctionnalités Clés de Nos Sites E-commerce</h2>
      <div class="feature-grid">
        {features.map((feature) => (
          <div class="feature-card">
            <Icon name={feature.icon} />
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="why-choose-us">
      <h2>Pourquoi Choisir CreationSiteWebPro pour Votre E-commerce à Casablanca?</h2>
      <ul>
        <li>Expertise locale du marché casablancais et marocain</li>
        <li>Solutions sur mesure adaptées à votre secteur d'activité</li>
        <li>Intégration des moyens de paiement prévus dans le devis</li>
        <li>Administration et accompagnement définis selon le projet</li>
        <li>Optimisation pour le référencement local à Casablanca</li>
      </ul>
    </section>

    <section class="process">
      <h2>Notre Processus de Création E-commerce</h2>
      <ol>
        <li>Analyse de vos besoins et de votre marché cible à Casablanca</li>
        <li>Conception d'une interface utilisateur intuitive et attrayante</li>
        <li>Développement de fonctionnalités e-commerce avancées</li>
        <li>Tests approfondis et optimisation des performances</li>
        <li>Formation à l'utilisation de votre nouvelle boutique en ligne</li>
        <li>Lancement et modalités de support convenues</li>
      </ol>
    </section>

    <section class="cta">
      <h2>Prêt à Lancer Votre E-commerce à Casablanca?</h2>
      <p>Contactez-nous dès aujourd'hui pour un devis personnalisé et propulsez votre entreprise dans l'ère du commerce en ligne!</p>
      <CTAButton text="Demander un devis" href="/contact" />
    </section>

    <section class="faq">
      <h2>Questions Fréquentes sur la Création d'E-commerce à Casablanca</h2>
      <dl>
        {faqItems.map((item) => (
          <Fragment>
            <dt>{item.question}</dt>
            <dd>{item.answer}</dd>
          </Fragment>
        ))}
      </dl>
    </section>
  </div>
  <JsonLd data={{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map((item) => ({
      "@type": "Question",
      "name": item.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.answer
      }
    }))
  }} />
</Layout>

<style>
  .e-commerce-casablanca {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
    margin-top: 0;
  }

  h1 {
    font-size: 2.5rem;
    color: var(--color-primary);
    text-align: center;
    margin-bottom: 1rem;
  }

  .intro {
    font-size: 1.2rem;
    text-align: center;
    margin-bottom: 2rem;
  }

  .hero {
    margin-bottom: 3rem;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .feature-card {
    background-color: #f5f5f5;
    padding: 1.5rem;
    border-radius: 8px;
    text-align: center;
  }

  .why-choose-us ul, .process ol {
    padding-left: 1.5rem;
  }

  .cta {
    background-color: var(--color-primary);
    color: white;
    padding: 3rem;
    border-radius: 8px;
    text-align: center;
    margin: 3rem 0;
  }

  .faq dt {
    font-weight: bold;
    margin-top: 1.5rem;
  }

  .faq dd {
    margin-left: 0;
    margin-top: 0.5rem;
  }

  @media (max-width: 768px) {
    .e-commerce-casablanca {
      padding: 1rem;
    }

    h1 {
      font-size: 2rem;
    }

    .feature-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
