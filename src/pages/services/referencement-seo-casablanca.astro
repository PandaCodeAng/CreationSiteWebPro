---
import Layout from '../../layouts/Layout.astro';
import CTAButton from '../../components/CTAButton.astro';
import OptimizedImage from '../../components/OptimizedImage.astro';
import JsonLd from '../../components/JsonLd.astro';
import Icon from '../../components/Icon.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
const breadcrumbItems = [
  { name: 'Accueil', url: '/' },
  { name: 'Services', url: '/services' },
  { name: 'Référencement SEO' }
];
const canonical = "https://www.creationsitewebpro.com/services/referencement-seo-casablanca";
const pageTitle = "Référencement SEO Casablanca | Agence SEO Maroc";
const pageDescription = "Audit SEO, optimisation technique, contenu et référencement local à Casablanca, avec des indicateurs définis selon les objectifs de votre entreprise.";

const services = [
  {
    title: "Audit SEO Complet",
    description: "Analyse approfondie de votre site et de sa performance SEO actuelle.",
    icon: "magnifying-glass"
  },
  {
    title: "Optimisation On-Page",
    description: "Optimisation du contenu, de la structure et des balises de votre site.",
    icon: "code"
  },
  {
    title: "Création de Contenu SEO",
    description: "Rédaction de contenu optimisé pour les moteurs de recherche et vos utilisateurs.",
    icon: "pencil"
  },
  {
    title: "Référencement Local",
    description: "Optimisation de la présence locale et de la cohérence des informations de l'entreprise.",
    icon: "map-pin"
  }
];

const faqItems = [
  {
    question: "Combien de temps faut-il pour voir des résultats SEO ?",
    answer: "Il n'existe pas de délai fixe. L'évolution dépend de l'état initial du site, de la concurrence, des contenus, de l'autorité du domaine et de la fréquence des optimisations. Les indicateurs sont suivis dans la durée."
  },
  {
    question: "Le SEO convient-il à toutes les entreprises de Casablanca ?",
    answer: "Le SEO est pertinent lorsqu'un public recherche réellement les services ou contenus proposés. L'audit initial permet d'évaluer la demande, la concurrence et les priorités avant de définir un accompagnement."
  },
  {
    question: "Pouvez-vous garantir la première place sur Google ?",
    answer: "Non. Une position déterminée ne peut pas être garantie. Les actions, priorités et indicateurs sont documentés, mais les résultats varient selon le site, le marché et la concurrence."
  }
];

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${canonical}#service`,
  "name": pageTitle,
  "description": pageDescription,
  "url": canonical,
  "provider": {
    "@id": "https://www.creationsitewebpro.com/#localbusiness"
  },
  "areaServed": {
    "@type": "City",
    "name": "Casablanca"
  },
  "serviceType": "Référencement naturel et SEO local"
};
---

<Layout title={pageTitle} description={pageDescription} canonical={canonical}>
  <JsonLd data={schemaData} />

  <div class="seo-casablanca">
    <Breadcrumbs items={breadcrumbItems} />
    <h1>{pageTitle}</h1>
    <p class="intro">{pageDescription}</p>

    <section class="hero">
      <OptimizedImage 
        src="/images/seo-casablanca-hero.jpg" 
        alt="Services de référencement SEO à Casablanca" 
        width={600} 
        height={300} 
        loading="eager"
        fetchpriority="high"
        sizes="(max-width: 800px) 100vw, 600px"
      />
    </section>

    <section class="services">
      <h2>Nos Services SEO à Casablanca</h2>
      <div class="service-grid">
        {services.map((service) => (
          <div class="service-card">
            <Icon name={service.icon}/>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="why-choose-us">
      <h2>Pourquoi Choisir Nos Services SEO à Casablanca?</h2>
      <ul>
        <li>Expertise du marché digital casablancais et marocain</li>
        <li>Stratégies SEO personnalisées pour votre secteur d'activité</li>
        <li>Recommandations fondées sur les consignes publiques des moteurs de recherche</li>
        <li>Rapports détaillés et suivi transparent de vos performances</li>
        <li>Priorités définies selon votre audience, vos contenus et vos objectifs</li>
      </ul>
    </section>

    <section class="process">
      <h2>Notre Approche SEO</h2>
      <ol>
        <li>Audit initial et analyse de la concurrence</li>
        <li>Définition d'une stratégie SEO sur mesure</li>
        <li>Optimisation technique et on-page de votre site</li>
        <li>Création de contenu de qualité et optimisé</li>
        <li>Développement de la notoriété avec des liens pertinents lorsque nécessaire</li>
        <li>Suivi des performances et ajustements continus</li>
      </ol>
    </section>

    <section class="case-study">
      <h2>Des résultats suivis avec des indicateurs vérifiables</h2>
      <p>Chaque accompagnement définit ses indicateurs avant le démarrage : visibilité sur les requêtes prioritaires, clics organiques, demandes de contact et conversions. Les résultats dépendent du marché, du site et de la concurrence.</p>
      <CTAButton text="Découvrir nos réalisations" href="/portfolio-realisations-web-casablanca-maroc" />
    </section>

    <section class="cta">
      <h2>Évaluons votre visibilité organique à Casablanca</h2>
      <p>Présentez-nous votre site, votre marché et vos objectifs pour définir les premières vérifications utiles.</p>
      <CTAButton text="Présenter mon besoin SEO" href="/contact" />
    </section>

    <section class="faq">
      <h2>Questions Fréquentes sur le SEO à Casablanca</h2>
      <dl>
        {faqItems.map((item) => (
          <Fragment>
            <dt>{item.question}</dt>
            <dd>{item.answer}</dd>
          </Fragment>
        ))}
      </dl>
    </section>
  </div>
  <JsonLd data={{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map((item) => ({
      "@type": "Question",
      "name": item.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.answer
      }
    }))
  }} />
</Layout>

<style>
  .seo-casablanca {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
    margin-top: 0;
  }

  h1 {
    font-size: 2.5rem;
    color: var(--color-primary);
    text-align: center;
    margin-bottom: 1rem;
  }

  .intro {
    font-size: 1.2rem;
    text-align: center;
    margin-bottom: 2rem;
  }

  .hero {
    margin-bottom: 3rem;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .service-card {
    background-color: #f5f5f5;
    padding: 1.5rem;
    border-radius: 8px;
    text-align: center;
    transition: transform 0.3s ease;
  }

  .service-card:hover {
    transform: translateY(-5px);
  }

  .why-choose-us ul, .process ol {
    padding-left: 1.5rem;
    margin-top: 1rem;
  }

  .case-study {
    background-color: #e6f2ff;
    padding: 2rem;
    border-radius: 8px;
    margin: 3rem 0;
  }

  .cta {
    background-color: var(--color-primary);
    color: white;
    padding: 3rem;
    border-radius: 8px;
    text-align: center;
    margin: 3rem 0;
  }

  .faq dt {
    font-weight: bold;
    margin-top: 1.5rem;
  }

  .faq dd {
    margin-left: 0;
    margin-top: 0.5rem;
  }

  @media (max-width: 768px) {
    .seo-casablanca {
      padding: 1rem;
      margin-top: 0;
    }

    h1 {
      font-size: 2rem;
    }

    .service-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
