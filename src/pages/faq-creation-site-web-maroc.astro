---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import JsonLd from '../components/JsonLd.astro';
import { pricingTiers } from '../data/business';

const canonical = 'https://www.creationsitewebpro.com/faq-creation-site-web-maroc';
const breadcrumbItems = [
  { name: 'Accueil', url: '/' },
  { name: 'FAQ' }
];
const schemaBreadcrumbs = [{ name: 'FAQ création site web Maroc' }];
const pageTitle = "FAQ Création Site Web Maroc & Prix 2026 | CreationSiteWebPro";
const pageDescription = "Prix, délais, SEO, maintenance, paiement en ligne : les réponses chiffrées sur la création d'un site web au Maroc. Site vitrine dès 7 500 MAD.";

// Chaque réponse commence par une affirmation extractible et contient au moins un
// chiffre ou une condition vérifiable. Les réponses évasives notées 28-38/100 en
// citabilité par l'audit GEO ont été réécrites ici (M-7).
const faqs = [
  {
    question: "Combien coûte la création d'un site web à Casablanca ?",
    answer: "Un site vitrine professionnel démarre à 7 500 MAD et une boutique e-commerce standard à 15 000 MAD. Un projet sur mesure (application web, portail métier) est chiffré après un cadrage fonctionnel. Ces montants correspondent au périmètre décrit dans nos offres ; les taxes applicables et les coûts externes éventuels — nom de domaine, hébergement au-delà de la première année, licences de modules — sont détaillés au devis."
  },
  {
    question: "Combien de temps faut-il pour créer un site web ?",
    answer: "Un site vitrine est livré en 2 à 3 semaines et un site e-commerce en 4 à 6 semaines, à partir de la validation de la maquette. Un projet sur mesure est planifié au cadrage. Le délai court à compter de la réception de vos contenus : textes, photos et, pour une boutique, le catalogue produits. C'est le poste qui décale le plus souvent un calendrier."
  },
  {
    question: "Proposez-vous des services de maintenance après le lancement du site ?",
    answer: "Oui, un forfait de maintenance mensuel est disponible. Il couvre les mises à jour de sécurité du CMS et des extensions, les sauvegardes régulières, la surveillance de la disponibilité et le support technique. Son contenu exact et son tarif en dirhams sont précisés dans le devis. La maintenance n'est pas incluse d'office dans le prix de création : c'est une prestation distincte, que vous pouvez refuser."
  },
  {
    question: "Puis-je mettre à jour moi-même le contenu de mon site ?",
    answer: "Oui : nous configurons un CMS (par exemple WordPress) qui vous permet de modifier vous-même textes et images après la mise en ligne. Une session de formation est prévue à la livraison, et vous recevez les accès administrateur. Le périmètre exact de votre autonomie — ajout de pages, gestion du blog, modification des produits — est défini avec vous avant le développement, car il détermine la structure du back-office."
  },
  {
    question: "Votre entreprise s'occupe-t-elle du référencement (SEO) ?",
    answer: "Oui, à deux niveaux. Chaque site livré inclut le SEO technique de base : indexation, balises title et description, structure de titres, données structurées et optimisation des temps de chargement. Un accompagnement continu (audit, contenus, netlinking, suivi de positions) est proposé séparément, sur devis. Une première position ou une date précise ne peuvent pas être garanties : aucun prestataire ne contrôle l'algorithme de Google."
  },
  {
    question: "Créez-vous des sites web adaptés aux mobiles ?",
    answer: "Oui, tous nos sites sont conçus en mobile-first et l'affichage est vérifié sur smartphone, tablette et ordinateur avant la mise en ligne. Ce choix n'est pas cosmétique : au Maroc, l'accès à Internet est très majoritairement mobile, comme le montrent les tableaux de bord trimestriels publiés par l'ANRT. Nous visons également les seuils Core Web Vitals de Google (LCP sous 2,5 s, CLS sous 0,1) sur les pages livrées."
  },
  {
    question: "Mes clients pourront-ils payer par carte bancaire ?",
    answer: "Oui, sous condition d'éligibilité bancaire. Au Maroc, le paiement par carte sur un site marchand passe par un acquéreur partenaire du Centre Monétique Interbancaire (CMI) et suppose un contrat marchand établi à votre nom. Nous préparons le dossier technique et réalisons l'intégration, mais l'ouverture du contrat relève de votre banque et ne peut pas être garantie par l'agence. Le paiement à la livraison et le virement sont disponibles sans cette contrainte."
  },
  {
    question: "À qui appartiennent le site et les données une fois le projet livré ?",
    answer: "Le site, ses contenus et ses données vous appartiennent après règlement intégral. Vous recevez les accès administrateur, l'accès à l'hébergement et au nom de domaine, ainsi que la documentation technique. Les conditions de propriété, d'hébergement, de réversibilité et d'accès au code figurent dans la proposition commerciale et dans nos conditions générales de vente."
  },
  {
    question: "Traitez-vous les données personnelles conformément à la loi marocaine ?",
    answer: "Oui. Les formulaires et les traitements de données que nous mettons en place tiennent compte de la loi 09-08 relative à la protection des personnes physiques à l'égard du traitement des données à caractère personnel, dont l'application est contrôlée par la CNDP. Les déclarations éventuelles auprès de la CNDP restent à la charge du responsable de traitement, c'est-à-dire vous, mais nous fournissons les éléments techniques nécessaires au dossier."
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${canonical}#faq`,
  name: 'Questions fréquentes sur la création de site web au Maroc',
  url: canonical,
  inLanguage: 'fr-MA',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  breadcrumbs={schemaBreadcrumbs}
>
  <JsonLd data={faqSchema} />
  <div class="faq-page">
    <Breadcrumbs items={breadcrumbItems} />

    <h1>FAQ création site web au Maroc</h1>
    <p class="intro">{pageDescription}</p>

    <div class="table-scroll">
      <table class="faq-table">
        <caption>Repères chiffrés : prix de départ et délai indicatif par type de projet</caption>
        <thead>
          <tr>
            <th scope="col">Type de projet</th>
            <th scope="col">Prix de départ</th>
            <th scope="col">Délai indicatif</th>
          </tr>
        </thead>
        <tbody>
          {pricingTiers.map((tier) => (
            <tr>
              <th scope="row">{tier.name}</th>
              <td>{tier.priceLabel}</td>
              <td>{tier.deliveryTime}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="faq-container">
      {faqs.map((faq) => (
        <div class="faq-item">
          <h2>{faq.question}</h2>
          <p>{faq.answer}</p>
        </div>
      ))}
    </div>

    <section class="cta-section">
      <h2>Vous avez d'autres questions ?</h2>
      <p>Présentez votre projet et nous vous répondons avec un périmètre, un délai et un montant en dirhams.</p>
      <a href="/contact" class="cta-button">Nous contacter</a>
    </section>
  </div>
</Layout>

<style>
  .faq-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1rem;
    margin-top: 5rem;
  }

  h1 {
    color: var(--color-primary);
    font-size: clamp(2rem, 5vw, 2.5rem);
    margin-bottom: 1rem;
    text-align: center;
  }

  .intro {
    text-align: center;
    margin-bottom: 2rem;
    font-size: clamp(1rem, 3vw, 1.1rem);
  }

  /* Le tableau défile dans son propre conteneur : la page ne doit jamais
     défiler horizontalement sur mobile. */
  .table-scroll {
    overflow-x: auto;
    margin-bottom: 3rem;
    -webkit-overflow-scrolling: touch;
  }

  .faq-table {
    width: 100%;
    min-width: 480px;
    border-collapse: collapse;
    background: #fff;
    font-size: 0.95rem;
  }

  .faq-table caption {
    caption-side: top;
    text-align: left;
    font-size: 0.9rem;
    color: #555;
    padding-bottom: 0.75rem;
  }

  .faq-table th,
  .faq-table td {
    padding: 0.75rem 1rem;
    text-align: left;
    border-bottom: 1px solid #e6e9f0;
  }

  .faq-table thead th {
    background: var(--color-primary);
    color: #fff;
    font-weight: 600;
  }

  .faq-table tbody th {
    color: var(--color-primary);
    font-weight: 700;
  }

  .faq-container {
    margin-bottom: 3rem;
  }

  .faq-item {
    margin-bottom: 2rem;
    border-bottom: 1px solid #eee;
    padding-bottom: 1rem;
  }

  .faq-item h2 {
    color: var(--color-secondary);
    font-size: clamp(1.2rem, 4vw, 1.5rem);
    margin-bottom: 0.5rem;
  }

  .faq-item p {
    font-size: clamp(0.9rem, 3vw, 1rem);
    line-height: 1.6;
  }

  .cta-section {
    background-color: #f0f0f0;
    padding: 2rem;
    border-radius: 8px;
    text-align: center;
  }

  .cta-section h2 {
    color: var(--color-primary);
    font-size: clamp(1.5rem, 4vw, 2rem);
    margin-bottom: 1rem;
  }

  .cta-button {
    display: inline-block;
    background-color: var(--color-secondary);
    color: white;
    padding: 0.75rem 1.5rem;
    text-decoration: none;
    border-radius: 5px;
    font-size: 1rem;
    margin-top: 1rem;
    transition: background-color 0.3s ease;
  }

  .cta-button:hover {
    background-color: var(--color-primary);
  }

  @media (max-width: 768px) {
    .faq-page {
      padding: 1rem;
      margin-top: 11rem;
    }
  }
</style>
