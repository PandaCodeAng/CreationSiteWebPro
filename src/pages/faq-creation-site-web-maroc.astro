---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import JsonLd from '../components/JsonLd.astro';
const breadcrumbItems = [
  { name: 'Accueil', url: '/' },
  { name: 'Faq' }
];
const pageTitle = "FAQ Création Site Web Maroc & Prix 2026 | CreationSiteWebPro";
const pageDescription = "Toutes les réponses sur la création de site web au Maroc : prix, délais, SEO, maintenance. Devis gratuit personnalisé pour votre projet à Casablanca.";

const faqs = [
  {
    question: "Combien coûte la création d'un site web à Casablanca ?",
    answer: "Un site vitrine professionnel démarre à 7 500 MAD et une boutique e-commerce standard à 15 000 MAD. Une application web est chiffrée après un cadrage fonctionnel. Le devis final dépend des contenus, fonctionnalités et intégrations."
  },
  {
    question: "Combien de temps faut-il pour créer un site web ?",
    answer: "La durée dépend du périmètre, des contenus, des intégrations et des validations. Les étapes et la date de livraison prévisionnelle sont précisées dans le devis avant le démarrage."
  },
  {
    question: "Proposez-vous des services de maintenance après le lancement du site ?",
    answer: "Des modalités de maintenance peuvent être prévues selon le projet. Les mises à jour, sauvegardes, contrôles et délais d'assistance inclus sont détaillés dans la proposition commerciale."
  },
  {
    question: "Puis-je mettre à jour moi-même le contenu de mon site ?",
    answer: "Le choix du système de gestion de contenu et votre niveau d'autonomie sont définis pendant le cadrage. Une prise en main peut être prévue lorsque l'administration du contenu fait partie du périmètre."
  },
  {
    question: "Votre entreprise s'occupe-t-elle du référencement (SEO) ?",
    answer: "Les sites incluent un socle d'indexabilité, de métadonnées, de structure sémantique et de performance. Un accompagnement SEO continu peut être défini séparément, avec des indicateurs adaptés au marché."
  },
  {
    question: "Créez-vous des sites web adaptés aux mobiles ?",
    answer: "Oui. L'affichage responsive sur smartphones, tablettes et ordinateurs fait partie du socle de conception. Les principaux parcours sont vérifiés avant la mise en ligne."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout title={pageTitle} description={pageDescription} canonical="https://www.creationsitewebpro.com/faq-creation-site-web-maroc">
  <JsonLd data={faqSchema} />
  <div class="faq-page">
    <Breadcrumbs items={breadcrumbItems} />

    <h1>{pageTitle}</h1>
    <p class="intro">{pageDescription}</p>

    <div class="faq-container">
      {faqs.map((faq) => (
        <div class="faq-item">
          <h2>{faq.question}</h2>
          <div>
            <p>{faq.answer}</p>
          </div>
        </div>
      ))}
    </div>

    <section class="cta-section">
      <h2>Vous avez d'autres questions ?</h2>
      <p>N'hésitez pas à nous contacter pour obtenir des réponses personnalisées à vos questions.</p>
      <a href="/contact" class="cta-button">Contactez-nous</a>
    </section>
  </div>
</Layout>

<style>
  .faq-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1rem;
    margin-top: 0;
  }

  h1 {
    color: var(--color-primary);
    font-size: clamp(2rem, 5vw, 2.5rem);
    margin-bottom: 1rem;
    text-align: center;
  }

  .intro {
    text-align: center;
    margin-bottom: 2rem;
    font-size: clamp(1rem, 3vw, 1.1rem);
  }

  .faq-container {
    margin-bottom: 3rem;
  }

  .faq-item {
    margin-bottom: 2rem;
    border-bottom: 1px solid #eee;
    padding-bottom: 1rem;
  }

  .faq-item h2 {
    color: var(--color-secondary);
    font-size: clamp(1.2rem, 4vw, 1.5rem);
    margin-bottom: 0.5rem;
  }

  .faq-item p {
    font-size: clamp(0.9rem, 3vw, 1rem);
    line-height: 1.6;
  }

  .cta-section {
    background-color: #f0f0f0;
    padding: 2rem;
    border-radius: 8px;
    text-align: center;
  }

  .cta-section h2 {
    color: var(--color-primary);
    font-size: clamp(1.5rem, 4vw, 2rem);
    margin-bottom: 1rem;
  }

  .cta-button {
    display: inline-block;
    background-color: var(--color-secondary);
    color: white;
    padding: 0.75rem 1.5rem;
    text-decoration: none;
    border-radius: 5px;
    font-size: 1rem;
    margin-top: 1rem;
    transition: background-color 0.3s ease;
  }

  .cta-button:hover {
    background-color: var(--color-primary);
  }

  @media (max-width: 768px) {
    .faq-page {
      padding: 1rem;
      margin-top: 0;
    }
  }
</style>
