---
import Layout from '../../layouts/Layout.astro';
import JsonLd from '../../components/JsonLd.astro';
import { generateTimeTag } from '../../utils/dates';
import { articles, BLOG_URL, createBlogSchema, getAuthorProfile } from './_articles';

const schemaBreadcrumbs = [{ name: 'Blog' }];

const pageTitle = "Blog Création Site Web & SEO au Maroc | CreationSiteWebPro";
const pageDescription = "Guides pratiques sur la création de sites web, le e-commerce et le SEO à Casablanca et au Maroc : budget, conception, contenu et performance.";

const blogPosts = articles;
const blogCategories = [
  {
    id: 'creation-web-casablanca',
    category: 'Création Web Casablanca',
    heading: 'Création de site web à Casablanca',
    description: 'Guides consacrés au cadrage, au budget et à la conception d’un site web professionnel à Casablanca.',
  },
  {
    id: 'creation-web-maroc',
    category: 'Création Web Maroc',
    heading: 'Création de site web au Maroc',
    description: 'Principes de conception de pages rapides, lisibles et adaptées aux entreprises marocaines.',
  },
  {
    id: 'seo-maroc',
    category: 'SEO Maroc',
    heading: 'Référencement SEO au Maroc',
    description: 'Conseils de structure, de contenu local et de performance pour les recherches au Maroc.',
  },
  {
    id: 'e-commerce-maroc',
    category: 'E-commerce Maroc',
    heading: 'E-commerce au Maroc',
    description: 'Choix de conception, de paiement, de livraison et d’expérience utilisateur pour une boutique en ligne.',
  },
  {
    id: 'transformation-digitale',
    category: 'Transformation Digitale',
    heading: 'Transformation digitale',
    description: 'Ressources pour structurer progressivement la présence en ligne et les outils numériques d’une entreprise.',
  },
  {
    id: 'web-design-maroc',
    category: 'Web Design Maroc',
    heading: 'Web design au Maroc',
    description: 'Approches visuelles et interactives à évaluer selon le public, le contenu et les objectifs du projet.',
  },
];
const schema = createBlogSchema(pageTitle, pageDescription);
---

<Layout
  breadcrumbs={schemaBreadcrumbs} 
  title={pageTitle}
  description={pageDescription}
  canonical={BLOG_URL}
>
  <JsonLd data={schema} />
  <div class="blog-index">
    <h1>Expertise en Création de Site Web à Casablanca et au Maroc</h1>
    <p class="intro">Bienvenue sur le blog de CreationSiteWebPro, votre source d'informations expertes sur la création de sites web au Maroc. Découvrez nos articles, guides et conseils pour réussir votre présence en ligne à Casablanca et dans tout le Maroc.</p>

    <section class="featured-posts">
      <h2>Articles Vedettes sur la Création de Site Web à Casablanca</h2>
      {blogPosts.slice(0, 2).map((post) => (
        <article class="blog-post-preview featured" itemscope itemtype="https://schema.org/BlogPosting">
          <h3 itemprop="headline">
            <a href={`/blog/${post.slug}`} itemprop="url">{post.title}</a>
          </h3>
          <p class="post-meta">
            <Fragment set:html={generateTimeTag(post.publishDate)} />
            | Par <span itemprop="author" itemscope itemtype="https://schema.org/Person">
              <a href={getAuthorProfile(post.author).url} itemprop="url"><span itemprop="name">{post.author}</span></a>
            </span>
            | Catégorie : <span itemprop="articleSection">{post.category}</span>
          </p>
          <p itemprop="description">{post.excerpt}</p>
          <a href={`/blog/${post.slug}`} class="read-more">Lire la suite sur la création de site web à {post.category.includes("Casablanca") ? "Casablanca" : "au Maroc"}</a>
        </article>
      ))}
    </section>

    <section class="categories">
      <h2>Explorez nos Catégories</h2>
      <ul>
        {blogCategories.map((category) => (
          <li><a href={`#${category.id}`}>{category.heading}</a></li>
        ))}
      </ul>
    </section>

    {blogCategories.map((category) => (
      <section id={category.id} class="category-section">
        <h2>{category.heading}</h2>
        <p>{category.description}</p>
        {blogPosts.filter((post) => post.category === category.category).map((post) => (
          <article class="blog-post-preview" itemscope itemtype="https://schema.org/BlogPosting">
            <h3 itemprop="headline">
              <a href={`/blog/${post.slug}`} itemprop="url">{post.title}</a>
            </h3>
            <p class="post-meta">
              <Fragment set:html={generateTimeTag(post.publishDate)} />
              | Par <a href={getAuthorProfile(post.author).url} itemprop="author">{post.author}</a>
            </p>
            <p itemprop="description">{post.excerpt}</p>
            <a href={`/blog/${post.slug}`} class="read-more">Lire l’article</a>
          </article>
        ))}
      </section>
    ))}

    <section class="cta">
      <h2>Prêt à Lancer votre Projet Web ?</h2>
      <p>Que vous soyez à Casablanca ou ailleurs au Maroc, notre équipe d'experts est là pour vous aider à créer un site web professionnel et performant.</p>
      <a href="/creation-site-web-casablanca" class="cta-button">Demandez un Devis Gratuit</a>
    </section>
  </div>
</Layout>

<style>
  .blog-index {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1rem;
    margin-top: 0;
  }

  h1, h2, h3 {
    color: var(--color-primary);
  }

  h1 {
    font-size: clamp(2rem, 5vw, 2.5rem);
    margin-bottom: 1rem;
    text-align: center;
  }

  h2 {
    font-size: clamp(1.5rem, 4vw, 2rem);
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .intro {
    text-align: center;
    margin-bottom: 2rem;
    font-size: clamp(1rem, 3vw, 1.1rem);
  }

  .blog-post-preview {
    margin-bottom: 2rem;
    border-bottom: 1px solid #eee;
    padding-bottom: 1rem;
  }

  .blog-post-preview h3 {
    font-size: clamp(1.2rem, 4vw, 1.5rem);
    margin-bottom: 0.5rem;
  }

  .blog-post-preview a {
    text-decoration: none;
    color: inherit;
  }

  .post-meta {
    font-size: 0.9rem;
    color: #666;
    margin-bottom: 0.5rem;
  }

  .read-more {
    display: inline-block;
    margin-top: 0.5rem;
    color: var(--color-secondary);
    text-decoration: none;
    font-weight: bold;
  }

  .featured-posts {
    margin-bottom: 3rem;
  }

  .featured {
    background-color: #f9f9f9;
    padding: 1rem;
    border-radius: 5px;
    margin-bottom: 1rem;
  }

  .categories ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .categories li a {
    background-color: var(--color-secondary);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 5px;
    text-decoration: none;
  }

  .cta {
    background-color: #f0f0f0;
    padding: 2rem;
    border-radius: 5px;
    text-align: center;
    margin-top: 3rem;
  }

  .cta-button {
    display: inline-block;
    background-color: var(--color-primary);
    color: white;
    padding: 0.75rem 1.5rem;
    text-decoration: none;
    border-radius: 5px;
    font-weight: bold;
    margin-top: 1rem;
  }

  @media (max-width: 768px) {
    .blog-index {
      padding: 1rem;
      margin-top: 0;
    }
  }
</style>
