---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import JsonLd from '../components/JsonLd.astro';

const canonical = 'https://www.creationsitewebpro.com/creation-site-web-maroc';
const title = 'Création de site web au Maroc | CreationSiteWebPro';
const description = 'Création de sites vitrines, boutiques e-commerce et applications web pour les entreprises au Maroc. Cadrage, conception, développement et mise en ligne.';

const services = [
  {
    title: 'Site vitrine',
    text: 'Présentez clairement votre activité, vos services et vos points de contact sur un site rapide, responsive et administrable.',
    href: '/creation-site-web-casablanca'
  },
  {
    title: 'Boutique e-commerce',
    text: 'Structurez votre catalogue, vos commandes et vos parcours d’achat selon vos moyens de paiement et vos règles de livraison.',
    href: '/services/e-commerce-casablanca'
  },
  {
    title: 'Application web',
    text: 'Digitalisez un processus avec un portail client, un outil de gestion ou une plateforme conçue autour de votre métier.',
    href: '/services/creation-application-web'
  }
];

const faq = [
  {
    question: 'Travaillez-vous avec des entreprises partout au Maroc ?',
    answer: 'Oui. L’agence est basée à Aïn Sebaâ, Casablanca, et peut organiser le cadrage, les validations et le suivi à distance avec des entreprises situées dans les différentes régions du Maroc.'
  },
  {
    question: 'Quel budget prévoir pour créer un site web ?',
    answer: 'Le budget dépend du nombre de pages, des fonctionnalités, des contenus et des intégrations. Nos repères tarifaires commencent à 7 500 MAD pour un site vitrine et à 15 000 MAD pour un site e-commerce. Un devis confirme le périmètre exact.'
  },
  {
    question: 'Le référencement naturel est-il pris en compte ?',
    answer: 'La structure sémantique, les métadonnées, les performances, le responsive et l’indexabilité font partie du socle technique. Une stratégie SEO continue peut être ajoutée selon vos objectifs et votre marché.'
  },
  {
    question: 'Pourrai-je modifier le contenu du site ?',
    answer: 'Le choix de l’outil d’administration et le niveau d’autonomie sont définis pendant le cadrage. Une prise en main peut être prévue lors de la livraison.'
  }
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${canonical}#service`,
  name: 'Création de site web au Maroc',
  description,
  url: canonical,
  provider: {
    '@id': 'https://www.creationsitewebpro.com/#localbusiness'
  },
  areaServed: {
    '@type': 'Country',
    name: 'Maroc'
  },
  serviceType: 'Conception et développement de sites web'
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};
---

<Layout title={title} description={description} canonical={canonical}>
  <JsonLd data={serviceSchema} />
  <JsonLd data={faqSchema} />

  <div class="national-page">
    <Breadcrumbs items={[
      { name: 'Accueil', url: '/' },
      { name: 'Création de site web au Maroc' }
    ]} />

    <header class="national-page__hero">
      <p class="eyebrow">Agence basée à Casablanca · Projets au Maroc</p>
      <h1>Création de site web au Maroc</h1>
      <p>{description}</p>
      <div class="actions">
        <a class="button" href="/contact">Demander un devis</a>
        <a class="text-link" href="/portfolio-realisations-web-casablanca-maroc">Voir nos réalisations</a>
      </div>
    </header>

    <section aria-labelledby="solutions-title">
      <h2 id="solutions-title">Une solution adaptée à votre projet</h2>
      <div class="cards">
        {services.map((service) => (
          <article>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
            <a href={service.href}>Découvrir le service <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    </section>

    <section class="deliverables" aria-labelledby="deliverables-title">
      <div>
        <p class="eyebrow">Un socle clair</p>
        <h2 id="deliverables-title">Ce que couvre la création du site</h2>
        <p>Le périmètre est défini avant la production afin de relier chaque page et chaque fonctionnalité à un besoin concret de votre entreprise.</p>
      </div>
      <ul>
        <li>Architecture des pages et parcours de navigation</li>
        <li>Interface adaptée aux mobiles, tablettes et ordinateurs</li>
        <li>Intégration des contenus fournis ou validés</li>
        <li>Fondations techniques pour l’indexation et le SEO</li>
        <li>Contrôles de performance, d’accessibilité et de sécurité</li>
        <li>Mise en ligne et prise en main selon le projet</li>
      </ul>
    </section>

    <section aria-labelledby="method-title">
      <h2 id="method-title">Comment se déroule un projet à distance ?</h2>
      <ol class="steps">
        <li><strong>Cadrage :</strong> objectifs, utilisateurs, contenus, fonctionnalités et contraintes.</li>
        <li><strong>Conception :</strong> arborescence, parcours et écrans principaux.</li>
        <li><strong>Production :</strong> développement et intégration avec des validations intermédiaires.</li>
        <li><strong>Recette :</strong> vérification du contenu, des formulaires, de l’affichage et des performances.</li>
        <li><strong>Livraison :</strong> déploiement, accès et modalités de maintenance convenues.</li>
      </ol>
      <p>Les échanges peuvent être organisés par visioconférence, téléphone et e-mail. Les livrables et décisions restent centralisés afin de faciliter le suivi, quelle que soit votre ville.</p>
    </section>

    <section aria-labelledby="faq-title">
      <h2 id="faq-title">Questions fréquentes</h2>
      <div class="faq-list">
        {faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <aside class="contact-panel">
      <h2>Présentez-nous votre projet</h2>
      <p>Indiquez votre activité, vos objectifs et les fonctionnalités envisagées pour recevoir une réponse adaptée.</p>
      <a class="button" href="/contact">Contacter l’agence</a>
      <a href="/creation-site-web-casablanca-prix">Consulter les repères de prix</a>
    </aside>
  </div>
</Layout>

<style>
  .national-page {
    max-width: 1120px;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }

  .national-page__hero {
    max-width: 850px;
    margin: 3rem auto 5rem;
    text-align: center;
  }

  .national-page__hero > p:not(.eyebrow) {
    max-width: 760px;
    margin: 1rem auto;
    font-size: 1.15rem;
  }

  .eyebrow {
    color: var(--color-secondary);
    font-weight: 700;
    letter-spacing: .07em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3 {
    color: var(--color-primary);
  }

  h1 {
    margin: .5rem 0 1rem;
    font-size: clamp(2.3rem, 6vw, 4.3rem);
    line-height: 1.08;
  }

  h2 {
    margin-top: 4rem;
    font-size: clamp(1.7rem, 4vw, 2.5rem);
  }

  .actions,
  .contact-panel {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
  }

  .button {
    display: inline-block;
    padding: .85rem 1.25rem;
    border-radius: .5rem;
    background: var(--color-secondary);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }

  .text-link,
  .cards a,
  .contact-panel > a:not(.button) {
    color: var(--color-primary);
    font-weight: 700;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .cards article,
  .deliverables,
  .steps,
  details {
    padding: 1.5rem;
    border: 1px solid rgba(7, 59, 76, .14);
    border-radius: 1rem;
    background: #fff;
  }

  .deliverables {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 4rem;
    background: #f4f8fa;
  }

  .deliverables h2 {
    margin-top: .5rem;
  }

  .deliverables li,
  .steps li {
    margin-bottom: .75rem;
  }

  .steps {
    background: #f4f8fa;
  }

  .faq-list {
    display: grid;
    gap: .8rem;
  }

  summary {
    cursor: pointer;
    color: var(--color-primary);
    font-weight: 700;
  }

  .contact-panel {
    margin-top: 4rem;
    padding: 2rem;
    border-radius: 1rem;
    background: var(--color-primary);
    color: #fff;
    text-align: center;
  }

  .contact-panel h2,
  .contact-panel p {
    flex-basis: 100%;
    margin: 0;
    color: #fff;
  }

  .contact-panel > a:not(.button) {
    color: #fff;
  }

  @media (max-width: 800px) {
    .cards,
    .deliverables {
      grid-template-columns: 1fr;
    }

    .national-page__hero {
      margin-top: 2rem;
    }
  }
</style>
