---
import Layout from '../layouts/Layout.astro';
import JsonLd from '../components/JsonLd.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const pageTitle = "À Propos | Votre Partenaire Digital à Casablanca Maroc";
const pageDescription = "Découvrez l'équipe de CreationSiteWebPro et ses domaines d'intervention en création de sites web et applications sur mesure à Casablanca.";
const siteUrl = "https://www.creationsitewebpro.com";
const aboutUrl = `${siteUrl}/a-propos-agence-web-casablanca`;
const organizationId = `${siteUrl}/#localbusiness`;
const breadcrumbItems = [
  { name: 'Accueil', url: '/' },
  { name: 'À Propos' }
];
const teamMembers = [
  {
    id: "mouhcine-talbi",
    name: "Mouhcine Talbi",
    role: "Fondateur & Directeur Technique",
    image: "/images/mouhcine-talbi.jpg",
    quote: "Notre mission est de fournir des solutions logicielles innovantes et sur mesure pour propulser nos clients vers le succès digital.",
    experience: [
      "Architecture et développement web",
      "Gestion de projets techniques",
      "Conception de solutions web sur mesure"
    ]
  },
  {
    id: "zakaria-boussnini",
    name: "Zakaria Boussnini",
    role: "Cofondateur & Directeur Commercial",
    image: "/images/zakaria-boussnini.jpg",
    quote: "L'expérience utilisateur est au cœur de chaque projet. Nous créons des interfaces intuitives qui enchantent les utilisateurs.",
    experience: [
      "Stratégie digitale",
      "Développement commercial",
      "Relation client et cadrage des projets"
    ]
  },
  {
    id: "safae-abed",
    name: "Safae Abed",
    role: "Ingénieure QA & Experte SEO",
    image: "/images/safae-abed.jpg",
    quote: "La qualité et la visibilité sont les piliers d'un projet web réussi. Nous suivons avec attention les tests, la performance et l'optimisation.",
    experience: [
      "Assurance qualité et tests fonctionnels",
      "SEO et stratégie de contenu",
      "Audit de performance web"
    ]
  },
  {
    id: "ikram-talbi",
    name: "Ikram Talbi",
    role: "Senior Analyste Fonctionnelle & Stratège Digital",
    image: "/images/Ikrame-talbi.jpg",
    quote: "Chaque projet web est une opportunité d'aligner technologie et objectifs business. Notre approche analytique vise des solutions adaptées aux besoins de nos clients.",
    experience: [
      "Analyse fonctionnelle et recueil des besoins",
      "Gestion de projets digitaux",
      "Optimisation des processus"
    ]
  },
  {
    id: "fatima-benzahra",
    name: "Fatima Ezzahra Benzahra",
    role: "Directrice Produit & Innovation",
    image: "/images/fatima-benzahra.jpg",
    quote: "Transformer les idées en produits digitaux performants nécessite une vision claire, une écoute active des besoins clients et une exécution rigoureuse.",
    experience: [
      "Experte en gestion et coordination de projets digitaux",
      "Expérience dans les environnements technologiques et de transformation numérique",
      "Spécialisée dans l'amélioration des produits digitaux et l'accompagnement client",
      "Forte sensibilité à l'innovation et à l'optimisation des processus"
    ]
  }
];

const milestones = [
  { year: 2013, event: "Fondation de CreationSiteWebPro" },
  { year: 2017, event: "Lancement du service d'applications web" }
];

const aboutSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AboutPage",
      "@id": `${aboutUrl}#webpage`,
      "url": aboutUrl,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": { "@id": `${siteUrl}/#website` },
      "about": teamMembers.map((member) => ({ "@id": `${aboutUrl}#${member.id}` }))
    },
    ...teamMembers.map((member) => ({
      "@type": "Person",
      "@id": `${aboutUrl}#${member.id}`,
      "name": member.name,
      "jobTitle": member.role,
      "url": `${aboutUrl}#${member.id}`,
      "image": `${siteUrl}${member.image}`,
      "description": member.experience.join(". "),
      "worksFor": {
        "@type": "Organization",
        "@id": organizationId,
        "name": "CreationSiteWebPro",
        "url": siteUrl
      }
    }))
  ]
};
---

<Layout title={pageTitle} description={pageDescription} canonical="https://www.creationsitewebpro.com/a-propos-agence-web-casablanca">
  <JsonLd data={aboutSchema} />
  <div class="about-page">
    <Breadcrumbs items={breadcrumbItems} />
    <section class="hero">
      <h1>{pageTitle}</h1>
      <p>{pageDescription}</p>
    </section>

    <section class="our-story">
      <h2>Notre Histoire</h2>
      <p>Fondée en 2013, CreationSiteWebPro accompagne les entreprises dans la conception de sites web, d'applications et de dispositifs digitaux adaptés à leurs objectifs.</p>
      <div class="timeline">
        {milestones.map((milestone) => (
          <div class="milestone">
            <div class="year">{milestone.year}</div>
            <div class="event">{milestone.event}</div>
          </div>
        ))}
      </div>
    </section>

    <section class="our-team">
      <h2>Notre Équipe</h2>
      <p>Derrière chaque projet réussi se cache une équipe passionnée et expérimentée. Découvrez les visages qui font de CreationSiteWebPro votre partenaire digital de confiance.</p>
      <div class="team-grid">
        {teamMembers.map((member) => (
          <div id={member.id} class="team-member" itemscope itemtype="https://schema.org/Person">
              <OptimizedImage 
                src={member.image} 
                alt={member.name} 
                className="team-member-image"
                width={180} 
                height={180}
                isCircular={true}
              />
            <h3 itemprop="name">{member.name}</h3>
            <p class="role" itemprop="jobTitle">{member.role}</p>
            <blockquote itemprop="description">"{member.quote}"</blockquote>
            <div class="experience-section">
              <h4>Expérience</h4>
              <ul class="experience-list">
                {member.experience.map((exp) => (
                  <li>
                    <span class="experience-icon">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18px" height="18px">
                        <path d="M0 0h24v24H0z" fill="none"/>
                        <path d="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z"/>
                      </svg>
                    </span>
                    <span class="experience-text">{exp}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="our-values">
      <h2>Nos Valeurs</h2>
      <ul>
        <li><strong>Innovation :</strong> Nous repoussons constamment les limites du possible dans le monde digital.</li>
        <li><strong>Excellence :</strong> Chaque détail compte dans la création d'une expérience utilisateur exceptionnelle.</li>
        <li><strong>Transparence :</strong> Nous croyons en une communication ouverte et honnête avec nos clients à chaque étape.</li>
        <li><strong>Engagement :</strong> Votre succès est notre succès. Nous nous investissons pleinement dans chaque projet.</li>
      </ul>
    </section>

    <section class="cta">
      <h2>Prêt à Transformer Votre Présence Digitale ?</h2>
      <p>Présentez-nous votre projet afin d'évaluer les besoins, les livrables et le calendrier.</p>
      <a href="/contact" class="cta-button">Présenter votre projet</a>
     </section>
  </div>
</Layout>

<style>
  .about-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
    margin-top: 0;
  }
  .social-proof {
    margin-top: 1rem;
    font-size: clamp(0.9rem, 2vw, 1rem);
    font-weight: bold;
  }
  .cta-button {
    display: inline-block;
    background-color: var(--color-secondary);
    color: white;
    padding: 0.75rem 1.5rem;
    text-decoration: none;
    border-radius: 5px;
    transition: background-color 0.3s ease, transform 0.3s ease;
    font-size: clamp(1rem, 2vw, 1.1rem);
  }
  .cta-button:hover {
    background-color: #ff8533;
    transform: translateY(-3px);
  }
  .urgency {
    display: inline-block;
    background-color: #ff4500;
    color: white;
    font-size: 0.8em;
    padding: 0.2em 0.5em;
    border-radius: 3px;
    margin-left: 0.5em;
  }
  .hero {
    text-align: center;
    margin-bottom: 3rem;
  }

  h1 {
    color: var(--color-primary);
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  h2 {
    color: var(--color-secondary);
    font-size: 2rem;
    margin-bottom: 1.5rem;
  }

  .timeline {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-top: 2rem;
  }

  .milestone {
    width: 30%;
    margin-bottom: 1.5rem;
    padding: 1rem;
    background-color: #f5f5f5;
    border-radius: 8px;
    text-align: center;
  }

  .year {
    font-weight: bold;
    color: var(--color-primary);
    font-size: 1.2rem;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .team-member {
    background-color: #f8f8f8;
    border-radius: 10px;
    padding: 2rem;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .team-member:hover {
    transform: translateY(-5px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
  }

  .team-member img {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 1rem;
    border: 4px solid var(--color-primary);
  }

  .team-member h3 {
    color: var(--color-primary);
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .role {
    color: var(--color-secondary);
    font-style: italic;
    margin-bottom: 1rem;
  }

  blockquote {
    font-style: italic;
    margin: 1rem 0;
    padding: 0.5rem;
    background-color: #f0f0f0;
    border-left: 3px solid var(--color-secondary);
    text-align: left;
  }

  .experience-section {
    margin-top: 1.5rem;
  }

  .experience-section h4 {
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .experience-list {
    list-style-type: none;
    padding-left: 0;
    text-align: left;
  }

  .experience-list li {
    display: flex;
    align-items: center;
    margin-bottom: 0.5rem;
    transition: transform 0.2s ease;
  }

  .experience-list li:hover {
    transform: translateX(5px);
  }

  .experience-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    background-color: var(--color-secondary);
    border-radius: 50%;
    margin-right: 0.5rem;
  }

  .experience-icon svg {
    fill: white;
  }

  .experience-text {
    flex: 1;
  }

  .role {
    color: var(--color-secondary);
    font-style: italic;
  }

  blockquote {
    font-style: italic;
    margin-top: 1rem;
    padding: 0.5rem;
    background-color: #f5f5f5;
    border-left: 3px solid var(--color-secondary);
  }

  .our-values ul {
    list-style-type: none;
    padding-left: 0;
  }

  .our-values li {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
    position: relative;
  }

  .our-values li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--color-secondary);
  }

  .cta {
    background-color: var(--color-primary);
    color: white;
    text-align: center;
    padding: 3rem;
    border-radius: 8px;
    margin-top: 3rem;
  }

  .cta h2 {
    color: white;
  }
  .team-member-image {
    width: 180px;
    height: 180px;
    border: 4px solid var(--color-primary);
  }
  @media (max-width: 768px) {
    .milestone {
      width: 100%;
    }
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 421px) {
    .about-page {
      padding: 1rem;
      margin-top: 0;
    }

    h1 {
      font-size: 1.8rem;
    }

    h2 {
      font-size: 1.5rem;
    }

    .timeline {
      flex-direction: column;
    }

    .milestone {
      width: 100%;
      margin-bottom: 1rem;
      padding: 0.75rem;
    }

    .year {
      font-size: 1rem;
    }

    .team-grid {
      grid-template-columns: 1fr;
    }

    .team-member {
      padding: 1rem;
    }

    .team-member img {
      width: 120px;
      height: 120px;
    }

    .team-member h3 {
      font-size: 1.2rem;
    }

    .role {
      font-size: 0.9rem;
    }

    blockquote {
      font-size: 0.9rem;
      padding: 0.5rem;
    }

    .experience-section h4 {
      font-size: 1rem;
    }

    .experience-list li {
      font-size: 0.8rem;
      margin-bottom: 0.3rem;
    }

    .experience-icon {
      width: 24px;
      height: 24px;
    }

    .experience-icon svg {
      width: 14px;
      height: 14px;
    }

    .our-values li {
      font-size: 0.9rem;
      padding-left: 1.2rem;
    }

    .cta {
      padding: 1.5rem;
    }

    .cta h2 {
      font-size: 1.3rem;
    }

    .cta p {
      font-size: 0.9rem;
    }
  }
</style>
