---
import Layout from '../layouts/Layout.astro';
import CTAButton from '../components/CTAButton.astro';
import PricingTable from '../components/PricingTable.astro';
import JsonLd from '../components/JsonLd.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import {
  LOCAL_BUSINESS_ID,
  WEBSITE_ID,
  buildAggregateOffer,
  pricingTiers,
  priceValidUntil
} from '../data/business';

const pageTitle = "Prix Création Site Web Casablanca 2026 | Devis Gratuit";
const pageDescription = "Combien coûte un site web à Casablanca ? Tarifs indicatifs 2026 : site vitrine dès 7 500 MAD, e-commerce dès 15 000 MAD et application web sur devis.";
const pageCanonical = "https://www.creationsitewebpro.com/creation-site-web-casablanca-prix";

const breadcrumbItems = [
  { name: 'Accueil', url: '/' },
  { name: 'Prix Création Site Web Casablanca' }
];

const schemaBreadcrumbs = [{ name: 'Prix Création Site Web Casablanca' }];

const faqItems = [
  {
    question: "Quel est le prix d'un site vitrine à Casablanca ?",
    answer: "Un site vitrine professionnel à Casablanca coûte entre 7 500 MAD et 15 000 MAD selon le nombre de pages et les fonctionnalités. Nos packs incluent design sur mesure, optimisation SEO et hébergement la première année."
  },
  {
    question: "Combien coûte un site e-commerce à Casablanca ?",
    answer: "La création d'une boutique en ligne à Casablanca est proposée à partir de 15 000 MAD. Le prix final dépend du nombre de produits, des intégrations de paiement (CMI, PayPal, virement) et des fonctionnalités avancées."
  },
  {
    question: "Le prix inclut-il le référencement SEO ?",
    answer: "Oui, chaque site livré inclut le SEO technique de base : indexation, balises title et description, structure de titres, données structurées et optimisation des temps de chargement. Un accompagnement SEO continu est proposé séparément, sur devis. Aucune position dans les résultats Google ne peut être garantie."
  },
  {
    question: "Combien de temps pour créer un site web à Casablanca ?",
    answer: "Un site vitrine est livré en 2 à 3 semaines, un site e-commerce en 4 à 6 semaines. Un projet sur mesure (application web, portail métier) est planifié au cadrage. Ces délais courent à partir de la réception de vos contenus : textes, photos et, pour une boutique, le catalogue produits."
  },
  {
    question: "Proposez-vous des facilités de paiement ?",
    answer: "Oui. Le règlement est échelonné : un acompte au démarrage du projet, puis le solde à la livraison. Le nombre d'échéances et les montants exacts figurent sur le devis et dans les conditions générales de vente."
  }
];

// L'entité LocalBusiness complète est injectée par Layout.astro : on la référence
// ici par son `@id` au lieu de la redéclarer partiellement.
const schemaData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${pageCanonical}#webpage`,
  "name": pageTitle,
  "description": pageDescription,
  "url": pageCanonical,
  "isPartOf": { "@id": WEBSITE_ID },
  "about": { "@id": LOCAL_BUSINESS_ID },
  "inLanguage": "fr-MA"
};

// `AggregateOffer` en MAD : les tarifs n'existaient qu'en texte libre dans les
// réponses FAQ, alors que ce sont les passages les plus cités du site (H-3).
const pricingSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${pageCanonical}#pricing-service`,
  "name": "Prix Création Site Web Casablanca 2026",
  "description": "Site vitrine à partir de 7 500 MAD, site e-commerce à partir de 15 000 MAD, application web sur devis. Taxes applicables et coûts externes précisés au devis.",
  "serviceType": "Création de site web",
  "provider": { "@id": LOCAL_BUSINESS_ID },
  "areaServed": [
    { "@type": "City", "name": "Casablanca" },
    { "@type": "Country", "name": "Maroc" }
  ],
  "offers": buildAggregateOffer('/creation-site-web-casablanca-prix')
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${pageCanonical}#faq`,
  "isPartOf": { "@id": `${pageCanonical}#webpage` },
  "mainEntity": faqItems.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  breadcrumbs={schemaBreadcrumbs}
>
  <JsonLd data={schemaData} />
  <JsonLd data={pricingSchema} />
  <JsonLd data={faqSchema} />

  <main class="prix-page">
    <Breadcrumbs items={breadcrumbItems} />

    <section class="prix-hero">
      <div class="container">
        <h1>Prix Création Site Web à Casablanca</h1>
        <p class="prix-hero__subtitle">Des tarifs transparents, sans surprise — adaptés aux entreprises marocaines</p>
        <div class="prix-hero__badges">
          <span class="badge">✓ Devis gratuit</span>
          <span class="badge">✓ Règlement échelonné</span>
          <span class="badge">✓ Périmètre et délais écrits</span>
        </div>
      </div>
    </section>

    <PricingTable
      title="Nos tarifs création site web Casablanca"
      subtitle="Site vitrine dès 7 500 MAD, e-commerce dès 15 000 MAD, projets sur mesure sur devis"
    />

    <section class="prix-tableau container">
      <h2>Tarifs 2026 en un tableau</h2>
      <p>
        Trois paliers, leur prix de départ en dirhams, le délai indicatif et le périmètre associé.
        Les taxes applicables et les coûts externes éventuels (nom de domaine, hébergement, licences)
        sont précisés au devis.
      </p>

      <div class="table-scroll">
        <table class="prix-table">
          <caption>Prix de départ des offres CreationSiteWebPro à Casablanca, valables jusqu'au 30 juin 2027</caption>
          <thead>
            <tr>
              <th scope="col">Type de projet</th>
              <th scope="col">Prix de départ</th>
              <th scope="col">Délai indicatif</th>
              <th scope="col">Périmètre inclus</th>
              <th scope="col">Adapté si vous voulez</th>
            </tr>
          </thead>
          <tbody>
            {pricingTiers.map((tier) => (
              <tr>
                <th scope="row">{tier.name}</th>
                <td>{tier.priceLabel}</td>
                <td>{tier.deliveryTime}</td>
                <td>{tier.scope}</td>
                <td>{tier.bestFor}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="prix-table__note">
        Tarifs indicatifs de départ exprimés en dirhams marocains (MAD), valables jusqu'au {priceValidUntil.split('-').reverse().join('/')}.
        Le devis final dépend du périmètre, des contenus fournis, des intégrations et du calendrier validés avec vous.
      </p>
    </section>

    <section class="prix-comparatif container">
      <h2>Combien coûte vraiment un site web à Casablanca en 2026 ?</h2>
      <p>
        Les prix de création de site web à Casablanca varient considérablement selon l'agence et le type de projet.
        Voici les fourchettes que nous pratiquons, du palier d'entrée au projet le plus large, pour vous aider à budgéter.
      </p>

      <div class="prix-grid">
        <div class="prix-card">
          <h3>Site Vitrine</h3>
          <div class="prix-range">{pricingTiers[0].rangeLabel}</div>
          <ul>
            <li>4 à 8 pages</li>
            <li>Design responsive mobile</li>
            <li>Formulaire de contact</li>
            <li>Optimisation SEO de base</li>
            <li>Livraison 2 à 3 semaines</li>
          </ul>
          <CTAButton href="/contact" text="Demander un devis" />
        </div>

        <div class="prix-card prix-card--featured">
          <span class="prix-card__badge">Le plus demandé</span>
          <h3>Site E-commerce</h3>
          <div class="prix-range">{pricingTiers[1].rangeLabel}</div>
          <ul>
            <li>Catalogue, variantes et stocks</li>
            <li>Paiement carte (via acquéreur CMI), à la livraison ou virement</li>
            <li>Gestion des commandes</li>
            <li>Socle SEO des catégories et produits</li>
            <li>Livraison 4 à 6 semaines</li>
          </ul>
          <CTAButton href="/contact" text="Demander un devis" />
        </div>

        <div class="prix-card">
          <h3>Application Web</h3>
          <div class="prix-range">{pricingTiers[2].rangeLabel}</div>
          <ul>
            <li>Fonctionnalités sur mesure</li>
            <li>Espace membres / dashboard</li>
            <li>Intégrations API</li>
            <li>Base de données métier</li>
            <li>Calendrier défini au cadrage</li>
          </ul>
          <CTAButton href="/contact" text="Demander un devis" />
        </div>
      </div>
    </section>

    <section class="prix-inclus container">
      <h2>Ce qui est inclus dans nos prix à Casablanca</h2>
      <p>
        Les prix affichés correspondent au périmètre décrit ci-dessous. Voici ce que chaque projet
        inclut systématiquement :
      </p>
      <div class="inclus-grid">
        <div class="inclus-item">
          <strong>Design sur mesure</strong>
          <p>Maquettes uniques adaptées à votre identité visuelle. Aucun template générique.</p>
        </div>
        <div class="inclus-item">
          <strong>Responsive mobile</strong>
          <p>Affichage vérifié sur smartphone, tablette et ordinateur. Au Maroc, l'accès à Internet est très majoritairement mobile : l'<a href="https://www.anrt.ma/" rel="noopener nofollow" target="_blank">ANRT</a> publie chaque trimestre le tableau de bord du parc et des usages.</p>
        </div>
        <div class="inclus-item">
          <strong>SEO technique</strong>
          <p>Balises optimisées, vitesse de chargement, sitemap, données structurées — la base pour être trouvé sur Google.</p>
        </div>
        <div class="inclus-item">
          <strong>Hébergement 1 an</strong>
          <p>Hébergement sécurisé inclus la première année. Certificat SSL (HTTPS) actif dès le lancement.</p>
        </div>
        <div class="inclus-item">
          <strong>Livraison testée</strong>
          <p>Tests multi-navigateurs et multi-appareils avant mise en ligne, avec vérification des formulaires et des fonctions prévues au devis.</p>
        </div>
        <div class="inclus-item">
          <strong>Formation & support</strong>
          <p>Formation à la gestion de votre site et support technique 30 jours après livraison.</p>
        </div>
      </div>
    </section>

    <section class="prix-faq container">
      <h2>Questions fréquentes sur les prix de création de site web à Casablanca</h2>
      <div class="faq-list" itemscope itemtype="https://schema.org/FAQPage">
        {faqItems.map((faq) => (
          <div class="faq-item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
            <h3 itemprop="name">{faq.question}</h3>
            <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
              <p itemprop="text">{faq.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="prix-cta container">
      <h2>Obtenez votre devis gratuit pour la création de votre site web à Casablanca</h2>
      <p>
        Chaque projet est unique. Contactez-nous pour recevoir un devis personnalisé sous 24h,
        adapté à votre secteur d'activité et à votre budget.
      </p>
      <CTAButton href="/contact" text="Devis gratuit en 24h" />
    </section>
  </main>
</Layout>

<style>
  .prix-page {
    margin-top: 5rem;
  }

  .prix-hero {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    color: white;
    padding: 4rem 1rem;
    text-align: center;
  }

  .prix-hero h1 {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    margin-bottom: 1rem;
    color: white;
  }

  .prix-hero__subtitle {
    font-size: 1.15rem;
    opacity: 0.9;
    margin-bottom: 1.5rem;
  }

  .prix-hero__badges {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .badge {
    background: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.4);
    padding: 0.4rem 1rem;
    border-radius: 2rem;
    font-size: 0.9rem;
  }

  .container {
    max-width: var(--max-width, 1200px);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .prix-tableau,
  .prix-comparatif,
  .prix-inclus,
  .prix-faq,
  .prix-cta {
    padding: 4rem 1.5rem;
  }

  .prix-tableau h2,
  .prix-comparatif h2,
  .prix-inclus h2,
  .prix-faq h2,
  .prix-cta h2 {
    color: var(--color-primary);
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: 1rem;
  }

  /* Le tableau défile dans son propre conteneur : la page ne doit jamais
     défiler horizontalement sur mobile. */
  .table-scroll {
    overflow-x: auto;
    margin-top: 2rem;
    -webkit-overflow-scrolling: touch;
  }

  .prix-table {
    width: 100%;
    min-width: 700px;
    border-collapse: collapse;
    font-size: 0.95rem;
    background: #fff;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    border-radius: 8px;
    overflow: hidden;
  }

  .prix-table caption {
    caption-side: top;
    text-align: left;
    font-size: 0.9rem;
    color: #555;
    padding-bottom: 0.75rem;
  }

  .prix-table th,
  .prix-table td {
    padding: 0.9rem 1rem;
    text-align: left;
    border-bottom: 1px solid #e6e9f0;
    vertical-align: top;
  }

  .prix-table thead th {
    background: var(--color-primary);
    color: #fff;
    font-weight: 600;
    white-space: nowrap;
  }

  .prix-table tbody th {
    font-weight: 700;
    color: var(--color-primary);
    white-space: nowrap;
  }

  .prix-table tbody tr:last-child th,
  .prix-table tbody tr:last-child td {
    border-bottom: none;
  }

  .prix-table tbody tr:nth-child(even) {
    background: #f8f9fd;
  }

  .prix-table__note {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: #555;
  }

  .prix-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .prix-card {
    border: 1px solid #e2e8f0;
    border-radius: var(--border-radius-md, 12px);
    padding: 2rem;
    position: relative;
  }

  .prix-card--featured {
    border-color: var(--color-primary);
    box-shadow: 0 4px 24px rgba(26, 86, 219, 0.12);
  }

  .prix-card__badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-primary);
    color: white;
    padding: 0.2rem 1rem;
    border-radius: 1rem;
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .prix-card h3 {
    font-size: 1.2rem;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .prix-range {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-cta, #e53e3e);
    margin-bottom: 1rem;
  }

  .prix-card ul {
    list-style: none;
    padding: 0;
    margin-bottom: 1.5rem;
  }

  .prix-card ul li {
    padding: 0.3rem 0;
    padding-left: 1.2rem;
    position: relative;
    font-size: 0.95rem;
  }

  .prix-card ul li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--color-success, #38a169);
    font-weight: 700;
  }

  .inclus-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .inclus-item {
    padding: 1.5rem;
    background: #f8fafc;
    border-radius: var(--border-radius-md, 12px);
    border-left: 4px solid var(--color-primary);
  }

  .inclus-item strong {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--color-primary);
  }

  .faq-list {
    margin-top: 2rem;
  }

  .faq-item {
    border-bottom: 1px solid #e2e8f0;
    padding: 1.5rem 0;
  }

  .faq-item h3 {
    font-size: 1.05rem;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .prix-cta {
    text-align: center;
    background: #f0f4ff;
    border-radius: var(--border-radius-md, 12px);
    margin: 0 1.5rem 4rem;
  }

  .prix-cta p {
    max-width: 600px;
    margin: 1rem auto 2rem;
    color: #4a5568;
  }
</style>
