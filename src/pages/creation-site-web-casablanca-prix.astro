---
import Layout from '../layouts/Layout.astro';
import CTAButton from '../components/CTAButton.astro';
import PricingTable from '../components/PricingTable.astro';
import JsonLd from '../components/JsonLd.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const pageTitle = "Prix Création Site Web Casablanca 2026 | Devis Gratuit";
const pageDescription = "Combien coûte un site web à Casablanca ? Tarifs indicatifs 2026 : site vitrine dès 7 500 MAD, e-commerce dès 15 000 MAD et application web sur devis.";
const pageCanonical = "https://www.creationsitewebpro.com/creation-site-web-casablanca-prix";

const breadcrumbItems = [
  { name: 'Accueil', url: '/' },
  { name: 'Prix Création Site Web Casablanca' }
];

const faqItems = [
  {
    question: "Quel est le prix d'un site vitrine à Casablanca ?",
    answer: "Un site vitrine professionnel à Casablanca est proposé à partir de 7 500 MAD. Le prix final dépend notamment du nombre de pages, des contenus, des langues et des fonctionnalités définies dans le devis."
  },
  {
    question: "Combien coûte un site e-commerce à Casablanca ?",
    answer: "La création d'une boutique en ligne à Casablanca est proposée à partir de 15 000 MAD. Le prix final dépend du catalogue, des règles de livraison, des moyens de paiement et des intégrations nécessaires."
  },
  {
    question: "Le prix inclut-il le référencement SEO ?",
    answer: "Oui, tous nos packs incluent une optimisation SEO de base (balises, performance et compatibilité mobile). Un accompagnement SEO continu et mesurable est disponible en option, sans promesse de position."
  },
  {
    question: "Combien de temps pour créer un site web à Casablanca ?",
    answer: "Le calendrier dépend du périmètre, des contenus, des intégrations et des validations. Une date de livraison prévisionnelle est indiquée dans le devis avant le démarrage."
  },
  {
    question: "Proposez-vous des facilités de paiement ?",
    answer: "L'échéancier et les modalités de paiement sont précisés dans la proposition commerciale. Des étapes de règlement peuvent être étudiées selon le projet."
  }
];

const schemaData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": pageTitle,
  "description": pageDescription,
  "url": pageCanonical,
  "provider": {
    "@id": "https://www.creationsitewebpro.com/#localbusiness"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout title={pageTitle} description={pageDescription} canonical={pageCanonical}>
  <JsonLd data={schemaData} />
  <JsonLd data={faqSchema} />

  <div class="prix-page">
    <Breadcrumbs items={breadcrumbItems} />

    <section class="prix-hero">
      <div class="container">
        <h1>Prix Création Site Web à Casablanca</h1>
        <p class="prix-hero__subtitle">Des tarifs transparents, sans surprise — adaptés aux entreprises marocaines</p>
        <div class="prix-hero__badges">
          <span class="badge">✓ Devis détaillé</span>
          <span class="badge">✓ Tarifs de départ en MAD</span>
          <span class="badge">✓ Planning défini au devis</span>
        </div>
      </div>
    </section>

    <PricingTable
      title="Nos tarifs création site web Casablanca"
      subtitle="Des offres de départ et un devis adapté au périmètre réel du projet"
    />

    <section class="prix-comparatif container">
      <h2>Combien coûte vraiment un site web à Casablanca en 2026 ?</h2>
      <p>
        Le budget varie selon le type de site, le volume de contenu, les fonctionnalités et les intégrations.
        Voici nos repères de départ pour préparer votre demande de devis.
      </p>

      <div class="prix-grid">
        <div class="prix-card">
          <h3>Site Vitrine</h3>
          <div class="prix-range">À partir de 7 500 MAD</div>
          <ul>
            <li>Pages et contenus définis au devis</li>
            <li>Design responsive mobile</li>
            <li>Formulaire de contact</li>
            <li>Optimisation SEO de base</li>
            <li>Planning défini au devis</li>
          </ul>
          <CTAButton href="/contact" text="Demander un devis" />
        </div>

        <div class="prix-card prix-card--featured">
          <span class="prix-card__badge">Le plus demandé</span>
          <h3>Site E-commerce</h3>
          <div class="prix-range">À partir de 15 000 MAD</div>
          <ul>
            <li>Catalogue défini selon le projet</li>
            <li>Moyens de paiement prévus au devis</li>
            <li>Gestion des commandes</li>
            <li>Socle SEO pour catégories et produits</li>
            <li>Planning défini au devis</li>
          </ul>
          <CTAButton href="/contact" text="Demander un devis" />
        </div>

        <div class="prix-card">
          <h3>Application Web</h3>
          <div class="prix-range">Sur devis</div>
          <ul>
            <li>Fonctionnalités sur mesure</li>
            <li>Espace membres / dashboard</li>
            <li>Intégrations API</li>
            <li>Modèle de données adapté au besoin</li>
            <li>Planning défini après cadrage</li>
          </ul>
          <CTAButton href="/contact" text="Demander un devis" />
        </div>
      </div>
    </section>

    <section class="prix-inclus container">
      <h2>Ce qui est inclus dans nos prix à Casablanca</h2>
      <p>
        La proposition commerciale précise les éléments inclus pour éviter toute ambiguïté.
        Le périmètre peut notamment couvrir les éléments suivants :
      </p>
      <div class="inclus-grid">
        <div class="inclus-item">
          <strong>Design sur mesure</strong>
          <p>Interface adaptée à votre identité visuelle et au périmètre validé.</p>
        </div>
        <div class="inclus-item">
          <strong>Responsive mobile</strong>
          <p>Votre site est conçu et testé pour les smartphones, tablettes et ordinateurs.</p>
        </div>
        <div class="inclus-item">
          <strong>SEO technique</strong>
          <p>Balises optimisées, vitesse de chargement, sitemap, données structurées — la base pour être trouvé sur Google.</p>
        </div>
        <div class="inclus-item">
          <strong>Hébergement et SSL</strong>
          <p>La solution d'hébergement, sa durée et ses conditions sont précisées dans le devis.</p>
        </div>
        <div class="inclus-item">
          <strong>Livraison testée</strong>
          <p>Vérifications des parcours, formulaires et principaux affichages avant la mise en ligne.</p>
        </div>
        <div class="inclus-item">
          <strong>Formation & support</strong>
          <p>La prise en main et les modalités de support sont définies selon l'offre retenue.</p>
        </div>
      </div>
    </section>

    <section class="prix-faq container">
      <h2>Questions fréquentes sur les prix de création de site web à Casablanca</h2>
      <div class="faq-list">
        {faqItems.map((faq) => (
          <div class="faq-item">
            <h3>{faq.question}</h3>
            <div>
              <p>{faq.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="prix-cta container">
      <h2>Obtenez votre devis gratuit pour la création de votre site web à Casablanca</h2>
      <p>
        Chaque projet est unique. Présentez-nous votre besoin pour recevoir un devis adapté
        à votre activité, vos contenus et vos fonctionnalités.
      </p>
      <CTAButton href="/contact" text="Demander un devis" />
    </section>
  </div>
</Layout>

<style>
  .prix-page {
    margin-top: 0;
  }

  .prix-hero {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    color: white;
    padding: 4rem 1rem;
    text-align: center;
  }

  .prix-hero h1 {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    margin-bottom: 1rem;
    color: white;
  }

  .prix-hero__subtitle {
    font-size: 1.15rem;
    opacity: 0.9;
    margin-bottom: 1.5rem;
  }

  .prix-hero__badges {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .badge {
    background: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.4);
    padding: 0.4rem 1rem;
    border-radius: 2rem;
    font-size: 0.9rem;
  }

  .container {
    max-width: var(--max-width, 1200px);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .prix-comparatif,
  .prix-inclus,
  .prix-faq,
  .prix-cta {
    padding: 4rem 1.5rem;
  }

  .prix-comparatif h2,
  .prix-inclus h2,
  .prix-faq h2,
  .prix-cta h2 {
    color: var(--color-primary);
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: 1rem;
  }

  .prix-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .prix-card {
    border: 1px solid #e2e8f0;
    border-radius: var(--border-radius-md, 12px);
    padding: 2rem;
    position: relative;
  }

  .prix-card--featured {
    border-color: var(--color-primary);
    box-shadow: 0 4px 24px rgba(26, 86, 219, 0.12);
  }

  .prix-card__badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-primary);
    color: white;
    padding: 0.2rem 1rem;
    border-radius: 1rem;
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .prix-card h3 {
    font-size: 1.2rem;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .prix-range {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-cta, #e53e3e);
    margin-bottom: 1rem;
  }

  .prix-card ul {
    list-style: none;
    padding: 0;
    margin-bottom: 1.5rem;
  }

  .prix-card ul li {
    padding: 0.3rem 0;
    padding-left: 1.2rem;
    position: relative;
    font-size: 0.95rem;
  }

  .prix-card ul li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--color-success, #38a169);
    font-weight: 700;
  }

  .inclus-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .inclus-item {
    padding: 1.5rem;
    background: #f8fafc;
    border-radius: var(--border-radius-md, 12px);
    border-left: 4px solid var(--color-primary);
  }

  .inclus-item strong {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--color-primary);
  }

  .faq-list {
    margin-top: 2rem;
  }

  .faq-item {
    border-bottom: 1px solid #e2e8f0;
    padding: 1.5rem 0;
  }

  .faq-item h3 {
    font-size: 1.05rem;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .prix-cta {
    text-align: center;
    background: #f0f4ff;
    border-radius: var(--border-radius-md, 12px);
    margin: 0 1.5rem 4rem;
  }

  .prix-cta p {
    max-width: 600px;
    margin: 1rem auto 2rem;
    color: #4a5568;
  }
</style>
