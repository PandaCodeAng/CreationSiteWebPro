---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import JsonLd from '../components/JsonLd.astro';
import SocialProof from '../components/SocialProof.astro';
import CTAButton from '../components/CTAButton.astro';
import Icon from '../components/Icon.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import PricingTable from '../components/PricingTable.astro';
import { napInfo, LOCAL_BUSINESS_ID, WEBSITE_ID, buildAggregateOffer } from '../data/business';

const canonical = 'https://www.creationsitewebpro.com/';

// L'entité LocalBusiness complète est injectée par Layout.astro. Cette page
// décrit seulement la page elle-même et l'offre chiffrée qu'elle présente.
// Aucun `aggregateRating` ni `review` : il n'existe aucun avis client public à
// ce jour, et en générer violerait les règles Google.
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  name: 'Création Site Web Casablanca | CreationSiteWebPro',
  description:
    'Agence web à Casablanca : site vitrine dès 7 500 MAD, site e-commerce dès 15 000 MAD, applications web et référencement SEO. Devis détaillé en MAD.',
  url: canonical,
  isPartOf: { '@id': WEBSITE_ID },
  about: { '@id': LOCAL_BUSINESS_ID },
  primaryImageOfPage: {
    '@type': 'ImageObject',
    url: 'https://www.creationsitewebpro.com/images/e-commerce-casablanca-hero.jpg'
  },
  inLanguage: 'fr-MA'
};

// Les tarifs sont le contenu le plus cité du site : ils doivent exister en
// données structurées et pas seulement en texte libre (H-3 de l'audit GEO).
const pricingSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${canonical}#offre`,
  name: 'Création de sites web professionnels à Casablanca',
  description:
    'Site vitrine à partir de 7 500 MAD, site e-commerce à partir de 15 000 MAD, applications web sur devis. Taxes et périmètre précisés au devis.',
  serviceType: 'Création de site web',
  provider: { '@id': LOCAL_BUSINESS_ID },
  areaServed: [
    { '@type': 'City', name: 'Casablanca' },
    { '@type': 'Country', name: 'Maroc' }
  ],
  offers: buildAggregateOffer('/creation-site-web-casablanca-prix')
};

// Les réponses reprennent mot pour mot le texte visible et commencent par une
// affirmation extractible : une IA à qui l'on demande « cette agence propose-t-elle
// X ? » a besoin d'un oui/non chiffré, pas d'un renvoi au cadrage (audit GEO).
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${canonical}#faq`,
  isPartOf: { '@id': `${canonical}#webpage` },
  mainEntity: [
    {
      '@type': 'Question',
      name: "Quel est le coût de création d'un site web à Casablanca ?",
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Un site vitrine professionnel démarre à 7 500 MAD et une boutique e-commerce standard à 15 000 MAD. Ces montants correspondent au périmètre décrit dans nos offres ; les taxes applicables et les coûts externes éventuels (nom de domaine, hébergement, licences) sont précisés au devis. Un projet sur mesure, comme une application web ou un portail métier, est chiffré après cadrage.'
      }
    },
    {
      '@type': 'Question',
      name: 'Combien de temps pour créer un site web à Casablanca ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Un site vitrine est livré en 2 à 3 semaines après validation de la maquette, un site e-commerce en 4 à 6 semaines. Ces délais courent à partir de la réception de vos contenus (textes, photos, catalogue) : c'est le poste qui décale le plus souvent un calendrier. Les étapes sont le cadrage, la conception graphique, le développement, les tests et la mise en ligne."
      }
    },
    {
      '@type': 'Question',
      name: 'Proposez-vous le référencement SEO à Casablanca ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Oui, chaque site livré inclut le SEO technique de base : indexation, balises title et description, structure de titres, données structurées et optimisation des temps de chargement. Une prestation de référencement continue (audit, contenus, suivi de positions) est proposée séparément, sur devis. Une première position ou une date précise ne peuvent pas être garanties : aucun prestataire ne contrôle l'algorithme de Google."
      }
    },
    {
      '@type': 'Question',
      name: 'Pourquoi choisir une agence locale à Casablanca ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Une agence basée à Casablanca permet trois choses concrètes : des réunions en présentiel à Ain Sebaa ou chez vous, une facturation en MAD sans frais de change, et des échanges en français comme en arabe. Sur un e-commerce, la proximité compte aussi pour le paiement (contrat marchand CMI) et la livraison, dont les règles diffèrent du marché européen."
      }
    },
    {
      '@type': 'Question',
      name: 'Est-ce que mes clients pourront payer en ligne ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Oui, nous intégrons le paiement par carte bancaire, le paiement à la livraison et le virement. Le paiement par carte passe au Maroc par un acquéreur partenaire du CMI : il suppose un contrat marchand à votre nom, sous réserve d'éligibilité. Nous préparons le dossier technique et l'intégration, mais l'activation relève de la banque et n'est pas garantie par l'agence."
      }
    }
  ]
};
---

<Layout 
  title="Création Site Web Casablanca | CreationSiteWebPro"
  description="Agence web à Casablanca : site vitrine dès 7 500 MAD, e-commerce dès 15 000 MAD, applications web et SEO. Devis détaillé en MAD, sans position Google garantie."
  canonical={canonical}>
  <JsonLd data={pageSchema} />
  <JsonLd data={pricingSchema} />
  <div class="home-page">
    <section class="hero" id="hero">
      <div class="hero__overlay"></div>
      <div class="container hero__container">
        <div class="hero__content">          <div class="hero__title-wrapper">
            <h1 class="hero__title">
              <span class="hero__title-highlight">Sites Web Professionnels</span>
              <span class="hero__title-second-line">à Casablanca</span>
            </h1>
          </div>
          <h2 class="hero__subtitle">Site vitrine dès 7 500 MAD, e-commerce dès 15 000 MAD</h2>
          <p class="hero__text">
            CreationSiteWebPro conçoit des sites web professionnels à Casablanca : site vitrine à partir de <strong>7 500 MAD</strong>, livré en 2 à 3 semaines, et boutique e-commerce à partir de <strong>15 000 MAD</strong>, livrée en 4 à 6 semaines. S'y ajoutent les applications web sur mesure et l'accompagnement SEO. Le devis détaille le périmètre, les livrables et le calendrier, en MAD.
          </p>
          <div class="hero__stats">
            <div class="hero__stat">
              <span class="hero__stat-number">7 500 MAD</span>
              <span class="hero__stat-text">Site vitrine, prix de départ</span>
            </div>
            <div class="hero__stat">
              <span class="hero__stat-number">15 000 MAD</span>
              <span class="hero__stat-text">E-commerce, prix de départ</span>
            </div>
            <div class="hero__stat">
