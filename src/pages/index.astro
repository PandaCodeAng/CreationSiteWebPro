              <span class="hero__stat-text">Année de création de l'agence</span>
            </div>
          </div>          <div class="hero__cta-container">
            <CTAButton href="/contact" className="hero__cta primary-cta">
              Demandez votre devis gratuit
              <Icon name="arrow-right" className="hero__cta-icon" />
            </CTAButton>
            <CTAButton href={`tel:${napInfo.phone.replace(/\s+/g, '')}`} className="hero__cta call-cta">
              <Icon name="phone" className="call-icon" />
              Appel direct
            </CTAButton>
            <CTAButton href="/portfolio-realisations-web-casablanca-maroc" className="hero__cta secondary-cta">
              Voir nos réalisations
            </CTAButton>
          </div>
        </div>
        <div class="hero__image-container">
          <OptimizedImage
            src="/images/e-commerce-casablanca-hero.jpg"
            alt="Création site web à Casablanca"
            className="hero__image"
            width={600}
            height={450}
            loading="eager"
            fetchpriority="high"
            sizes="(max-width: 1024px) 100vw, 45vw"
          />
          <div class="hero__clients">
            <p class="hero__clients-text">Ils nous font confiance</p>
            <div class="hero__clients-logos">
              <div class="hero__client-logo">
                <img src="/icons/le-cely.svg" alt="Le Cely" width="50" height="50" />
              </div>
              <div class="hero__client-logo">
                <img src="/icons/executive-travel.svg" alt="Executive Travel Shuttle" width="50" height="30" />
              </div>
              <div class="hero__client-logo">
                <img src="/icons/surf-logo.svg" alt="Morocco Surf" width="50" height="50" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <PricingTable
      title="Nos tarifs de départ"
      subtitle="Site vitrine dès 7 500 MAD, e-commerce dès 15 000 MAD et projets sur mesure sur devis"
    />
    
    <section class="services" id="services">
