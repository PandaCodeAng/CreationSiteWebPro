{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": ["@types/gtag.js"],
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@utils/*": ["src/utils/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strictNullChecks": true,
    "allowJs": true
  },
  "exclude": [
    "src/components/FixedHeader2.astro",
    "src/components/ModernHeader.astro"
  ]
}
